{
  "name": "libell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Level a motorhome / RV with your phone.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "flows": "node scripts/flows-test.mjs",
    "fit": "node scripts/fit-test.mjs",
    "bundle": "node scripts/bundle-guard.mjs",
    "timing": "node scripts/startup-timing.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
