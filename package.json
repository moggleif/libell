{
  "name": "libell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Level a motorhome / RV with your phone.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/generate-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4",
    "playwright": "^1.48.0"
  }
}
