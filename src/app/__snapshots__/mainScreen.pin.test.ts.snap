`;

exports[`the main screen (#735) > draws the same top bar, badges and level screen 1`] = `
"div id="indicators"
  div class="indicators"
    button aria-label="⚠ Measurements. The vehicle measurements have never been saved — tap to open Settings" class="indicators__lamp" hidden="" title="The vehicle measurements have never been saved — tap to open Settings" type="button" "⚠ Measurements"
    button aria-label="⚠ Calibrate. The phone is not calibrated — tap to open “Calibrate and zero”" class="indicators__lamp" hidden="" title="The phone is not calibrated — tap to open “Calibrate and zero”" type="button" "⚠ Calibrate"

div id="choices"
  button aria-label="Vehicle: Caravan" class="vehicle-badge" type="button" "Vehicle: Caravan"
  button aria-label="Target: Normal (level)" class="target-badge" type="button" "Target: Normal (level)"
  button aria-label="Hitch height: tap to level as usual again" class="hitch-badge" hidden="" type="button" "Hitch height"

div id="topbar-corner"
  div id="sensor-slot"
    button class="sensor-status" hidden="" type="button"
      svg aria-hidden="true" class="sensor-status__icon" viewBox="0 0 24 24"
        rect height="10" rx="2" width="10" x="7" y="7"
        line x1="9" x2="9" y1="2" y2="7"
        line x1="15" x2="15" y1="2" y2="7"
        line x1="9" x2="9" y1="17" y2="22"
        line x1="15" x2="15" y1="17" y2="22"
        line x1="2" x2="7" y1="9" y2="9"
        line x1="2" x2="7" y1="15" y2="15"
        line x1="17" x2="22" y1="9" y2="9"
        line x1="17" x2="22" y1="15" y2="15"

main class="app--level" id="app"
  div class="level-overlay" hidden=""
    div class="level-overlay__mark" "✓"
    p class="level-overlay__text" "Your vehicle is level!"
  p class="adjustable-line" hidden=""
  div class="rv-diagram rv-diagram--modern" style="--diagram-aspect: 0.5909090909090909;"
    div class="rv-diagram__stage"
      svg aria-label="Top-down view of your caravan showing the axle wheels and the jockey wheel" role="img" viewBox="0 0 260 440"
        path class="rv-diagram__arrow" d="M130 6 L118 28 L126 28 L126 44 L134 44 L134 28 L142 28 Z"
        path class="rv-diagram__drawbar" d="M88 190 L130 70 L172 190"
        circle class="rv-diagram__trim" cx="130" cy="66" r="7"
        rect class="rv-diagram__body" height="244" rx="34" width="136" x="62" y="176"
        rect class="rv-diagram__roof" height="208" rx="24" width="112" x="74" y="194"
        rect class="rv-diagram__trim" height="8" rx="4" width="68" x="96" y="180"
        rect class="rv-diagram__trim" height="156" rx="3" width="6" x="68" y="222"
        rect class="rv-diagram__trim" height="156" rx="3" width="6" x="186" y="222"
        rect class="rv-diagram__hatch" height="30" rx="6" width="44" x="108" y="212"
        rect class="rv-diagram__hatch" height="22" rx="5" width="28" x="116" y="366"
        line class="rv-diagram__crosshair" x1="130" x2="130" y1="248" y2="358"
        line class="rv-diagram__crosshair" x1="82" x2="178" y1="300" y2="300"
        circle class="rv-diagram__bubble-dial" cx="130" cy="300" r="44"
        circle class="rv-diagram__bubble-ring" cx="130" cy="300" r="13"
        circle class="rv-diagram__bubble" cx="130" cy="300" r="10"
      div class="wheel-card-layer"
        div aria-label="Jockey wheel" class="wheel-card wheel-card--center" data-wheel-y="118" role="group" style="top: calc(50% + (-0.231818 * var(--drawn-height)));"
          div aria-hidden="true" class="wheel-card__marker"
            span
          div class="wheel-card__text"
            div class="wheel-card__step"
            div class="wheel-card__mm"
            span class="visually-hidden"
        div aria-label="Left axle wheel" class="wheel-card wheel-card--left" data-wheel-y="318" role="group" style="top: calc(50% + (0.222727 * var(--drawn-height)));"
          div aria-hidden="true" class="wheel-card__marker"
            span
          div class="wheel-card__text"
            div class="wheel-card__step"
            div class="wheel-card__mm"
            span class="visually-hidden"
        div aria-label="Right axle wheel" class="wheel-card wheel-card--right" data-wheel-y="318" role="group" style="top: calc(50% + (0.222727 * var(--drawn-height)));"
          div aria-hidden="true" class="wheel-card__marker"
            span
          div class="wheel-card__text"
            div class="wheel-card__step"
            div class="wheel-card__mm"
            span class="visually-hidden"
  p class="status-line" hidden=""
  p class="hitch-offer"
    span class="hitch-offer__text" "Save the hitch height first?"
    button class="link-button" type="button" "Save"
    button class="link-button" type="button" "Not now"
  p class="tilt-readout"
  p class="app__hint" role="status" "Waiting for the tilt sensor…"
  div class="sensor-fallback" hidden=""
    p class="sensor-fallback__text" "Lost contact with the box"
    p class="sensor-fallback__hint" "Trying again automatically…"
    div class="sensor-fallback__actions"
      button class="menu__action" type="button" "Reconnect"
      button class="link-button" type="button" "Use the phone instead"
  div class="pose-overlay" hidden=""
    p class="pose-overlay__text"
    p class="pose-overlay__hint" "It only measures right lying flat, top up."
    button class="menu__action" type="button" "Show the box"
  div class="stale-overlay" hidden=""
    p class="stale-overlay__text" "No new sensor data — guidance is paused until it returns"
    button class="menu__action" type="button" "Show the box"
  div class="visually-hidden" role="status"
  div class="visually-hidden" role="alert""
`;

exports[`the start button where motion needs a tap (#735) > draws the same DOM 1`] = `
"main id="app"
  p class="app__hint" "Lay your phone flat inside the vehicle, top edge toward the front."
  button class="app__start" type="button" "Start""
`;

exports[`the toasts (#735) > draw the same DOM, with and without an action 1`] = `
"p class="toast" role="status" "Saved"

div class="toast toast--action" role="status"
  span "Deleted"
  button class="toast__action" type="button" "Undo""
`;
