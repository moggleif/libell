          button.menu__action.menu__action--secondary [hidden] [disabled] "Undo"
        details.menu__detail
          summary.sensor-status__debug-summary "More"
          button.menu__action.menu__action--secondary [disabled] "Check"
          button.menu__action.menu__action--secondary [disabled] "Clear calibration"
    div.box-step.is-open
      button.box-step__header
        span.box-step__mark "2"
        span.box-step__title "Zero the vehicle"
      div.box-step__body
        p.menu__text "Level the vehicle with a spirit level and put the phone in its usual spot."
        button.menu__action [disabled] "Zero now"
        p.menu__text.menu__text--status [hidden]
        button.menu__action.menu__action--secondary [hidden] [disabled] "Undo"
        details.menu__detail
          summary.sensor-status__debug-summary "More"
          button.menu__action.menu__action--secondary [disabled] "Check"
          button.menu__action.menu__action--secondary [hidden] [disabled] "Forget the zero"

# phone again
div
  div [hidden]
    h3.menu__heading "Zero the vehicle"
    p.menu__text "Level the vehicle once with a spirit level, then zero."
    button.menu__action "Zero now"
    p.menu__text.menu__text--status "box said no"
    button.menu__action.menu__action--secondary [hidden] "Undo"
    p.menu__text "The phone’s own calibration is hidden while the sensor box measures. To calibrate the phone, open the box and tap \\"Disconnect\\" first."
    button.link-button "Show the box"
  div.box-setup
    div.box-step.is-done
      button.box-step__header
        span.box-step__mark "✓"
        span.box-step__title "Phone calibrated"
      div.box-step__body [hidden]
        p.menu__text "Lay the phone on something flat."
        button.menu__action "Calibrate now"
        p.menu__text.menu__text--status [hidden]
        button.menu__action.menu__action--secondary [hidden] "Undo"
        button.link-button "No flat surface? Flip the phone"
        div [hidden]
          p.menu__text "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
          button.menu__action "Calibrate by flipping"
          p.menu__text.menu__text--status
          button.menu__action.menu__action--secondary [hidden] "Undo"
        details.menu__detail
          summary.sensor-status__debug-summary "More"
          button.menu__action.menu__action--secondary "Check"
          button.menu__action.menu__action--secondary "Clear calibration"
    div.box-step.is-open
      button.box-step__header
        span.box-step__mark "2"
        span.box-step__title "Zero the vehicle"
      div.box-step__body
        p.menu__text "Level the vehicle with a spirit level and put the phone in its usual spot."
        button.menu__action "Zero now"
        p.menu__text.menu__text--status [hidden]
        button.menu__action.menu__action--secondary [hidden] "Undo"
        details.menu__detail
          summary.sensor-status__debug-summary "More"
          button.menu__action.menu__action--secondary "Check"
          button.menu__action.menu__action--secondary [hidden] "Forget the zero""
`;

exports[`calibration section, pinned before the #416 split > draws the active box's zero the same (classic wizard) 1`] = `
"# phone active
div
  div [hidden]
    h3.menu__heading
    p.menu__text "Level the vehicle once with a spirit level, then zero."
    button.menu__action "Zero now"
    p.menu__text.menu__text--status
    button.menu__action.menu__action--secondary [hidden] "Undo"
    p.menu__text "The phone’s own calibration is hidden while the sensor box measures. To calibrate the phone, open the box and tap \\"Disconnect\\" first."
    button.link-button "Show the box"
  div
    h3.menu__heading "Calibrate the phone"
    p.menu__text "Put the phone on a surface you know is level, then tap Calibrate now. The current tilt becomes the zero point."
    p.menu__text.menu__text--status "Calibrated: front/back +0.4°, side/side +0.3°."
    button.menu__action.menu__action--secondary [hidden] "Undo"
    button.menu__action "Calibrate now"
    p.menu__text "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
    button.menu__action "Calibrate by flipping"
    p.menu__text.menu__text--status
    button.menu__action.menu__action--secondary [hidden] "Undo"
  div
    h3.menu__heading "Zero the vehicle"
    p.menu__text "Calibration is about the phone, not the spot where it lies. If the table tilts a little, the app shows that tilt. Level the vehicle once with a spirit level, put the phone in its usual place and zero."
    p.menu__text.menu__text--status "No vehicle zero — the phone spot counts as flat."
    button.menu__action.menu__action--secondary [hidden] "Undo"
    button.menu__action "Zero now"

