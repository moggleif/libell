exports[`calibration section, pinned before the #416 split > draws the active box's zero the same (modern wizard) 1`] = `
"# phone active
div.calibration-cards
  div.calibration-card [hidden]
    h3.calibration-card__title
    p.calibration-card__body "Level the vehicle once with a spirit level, then zero."
    button.menu__action "Zero now"
    p.menu__text.menu__text--status
    button.menu__action.menu__action--secondary [hidden] "Undo"
    p.calibration-card__body "The phone’s own calibration is hidden while the sensor box measures. To calibrate the phone, open the box and tap \\"Disconnect\\" first."
    button.link-button "Show the box"
  div.calibration-card
    div.calibration-card__header
      h3.calibration-card__title "Calibrate the phone"
      span.calibration-card__pill.calibration-card__pill--done "DONE"
    p.calibration-card__body "Put the phone on a surface you know is level, then tap Calibrate now. The current tilt becomes the zero point."
    button.menu__action "Calibrate now"
    p.calibration-card__body "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
    button.menu__action "Calibrate by flipping"
    p.menu__text.menu__text--status
    button.menu__action.menu__action--secondary [hidden] "Undo"
    p.menu__text.menu__text--status "Calibrated: front/back +0.4°, side/side +0.3°."
    button.menu__action.menu__action--secondary [hidden] "Undo"
  div.calibration-card
    div.calibration-card__header
      h3.calibration-card__title "Zero the vehicle"
      span.calibration-card__pill "NONE"
    p.calibration-card__body "Calibration is about the phone, not the spot where it lies. If the table tilts a little, the app shows that tilt. Level the vehicle once with a spirit level, put the phone in its usual place and zero."
    button.menu__action "Zero now"
    p.menu__text.menu__text--status "No vehicle zero — the phone spot counts as flat."
    button.menu__action.menu__action--secondary [hidden] "Undo"

