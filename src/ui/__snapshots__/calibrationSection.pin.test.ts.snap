// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`calibration section, pinned before the #416 split > draws every phone step the same (classic cards) 1`] = `
"# fresh
div
  div
    h3.menu__heading "Calibrate the phone"
    p.menu__text "Put the phone on a surface you know is level, then tap Calibrate now. The current tilt becomes the zero point."
    p.menu__text.menu__text--status "Not calibrated — using the raw sensor."
    button.menu__action.menu__action--secondary [hidden] "Undo"
    button.menu__action "Calibrate now"
    p.menu__text "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
    button.menu__action "Calibrate by flipping"
    p.menu__text.menu__text--status
    button.menu__action.menu__action--secondary [hidden] "Undo"
    button.menu__action.menu__action--secondary "Check"
    button.menu__action.menu__action--secondary [hidden] "Clear calibration"
  div
    h3.menu__heading "Zero the vehicle"
    p.menu__text "Calibration is about the phone, not the spot where it lies. If the table tilts a little, the app shows that tilt. Level the vehicle once with a spirit level, put the phone in its usual place and zero."
    p.menu__text.menu__text--status "No vehicle zero — the phone spot counts as flat."
    button.menu__action.menu__action--secondary [hidden] "Undo"
    button.menu__action "Zero now"
    button.menu__action.menu__action--secondary "Check"
    button.menu__action.menu__action--secondary [hidden] "Forget the zero"

# phone warning
div
  div
    h3.menu__heading "Calibrate the phone"
