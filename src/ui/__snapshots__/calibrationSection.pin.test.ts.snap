exports[`calibration section, pinned before the #416 split > draws every phone step the same (classic checklist) 1`] = `
"# fresh
div
  div.box-setup
    div.box-step.is-open
      button.box-step__header
        span.box-step__mark "1"
        span.box-step__title "Calibrate the phone"
      div.box-step__body
        p.menu__text "Lay the phone on something flat."
        button.menu__action "Calibrate now"
