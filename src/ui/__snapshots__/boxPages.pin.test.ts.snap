          p class="menu__text box-password__status" hidden=""
    div class="sensor-card is-lost"
      span aria-hidden="true" class="sensor-card__mark" "!"
      div class="sensor-card__text"
        button class="sensor-card__name sensor-row__status-button" type="button"
          span "Xparkle RVS01"
