exports[`the learn-the-mounting guide (#735) > draws the same DOM at every step 1`] = `
"div class="learn-mounting"
  h3 class="menu__heading" "Learn the mounting"
  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
  p class="menu__text" hidden=""
  button class="menu__action" type="button" "Learn the mounting"
  button class="menu__action" hidden="" type="button" "The front is raised"
  button class="menu__action" hidden="" type="button" "The right side is raised"
  button class="menu__action menu__action--secondary" hidden="" type="button" "Cancel"
  p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."

div class="learn-mounting"
  h3 class="menu__heading" "Learn the mounting"
  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
  p class="menu__text" "Raise the vehicle’s front a few centimetres, then press the button."
  button class="menu__action" hidden="" type="button" "Learn the mounting"
  button class="menu__action" type="button" "The front is raised"
  button class="menu__action" hidden="" type="button" "The right side is raised"
  button class="menu__action menu__action--secondary" type="button" "Cancel"
  p class="menu__text menu__text--status" hidden="" "No mounting learned — the box’s own directions are used."

div class="learn-mounting"
  h3 class="menu__heading" "Learn the mounting"
  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
  p class="menu__text" "Lower the front again. Now raise the right side a few centimetres, then press the button."
  button class="menu__action" hidden="" type="button" "Learn the mounting"
  button class="menu__action" hidden="" type="button" "The front is raised"
  button class="menu__action" type="button" "The right side is raised"
  button class="menu__action menu__action--secondary" type="button" "Cancel"
  p class="menu__text menu__text--status" hidden="" "No mounting learned — the box’s own directions are used."

div class="learn-mounting"
  h3 class="menu__heading" "Learn the mounting"
  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
  p class="menu__text" hidden="" "Lower the front again. Now raise the right side a few centimetres, then press the button."
  button class="menu__action" type="button" "Learn the mounting"
  button class="menu__action" hidden="" type="button" "The front is raised"
  button class="menu__action" hidden="" type="button" "The right side is raised"
  button class="menu__action menu__action--secondary" hidden="" type="button" "Cancel"
  p class="menu__text menu__text--status" "Done! Check it: raise the front and Libell should point to the rear wheels.""
`;

