                  button class="menu__action menu__action--secondary" data-offline="" disabled="" hidden="" type="button" "Cancel"
                  p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."
                button class="link-button" data-offline="" disabled="" hidden="" type="button" "Forget the direction"
