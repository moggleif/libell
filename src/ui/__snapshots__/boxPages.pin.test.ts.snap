                        text class="mounting-picker__front" text-anchor="middle" x="50" y="52" "FRONT ↑"
                        g transform="translate(50 100)"
                          g class="box-glyph" transform="scale(1.15) rotate(0)"
                            rect class="box-glyph__body" height="22" rx="2" width="44" x="-22" y="-11"
                            rect class="box-glyph__body" height="28" rx="3" width="30" x="-15" y="-14"
                            polygon class="box-glyph__ref" points="4,-12 10,-5 6.5,-5 6.5,0 1.5,0 1.5,-5 -2,-5"
                            polygon class="box-glyph__ref" points="-13,6 -6,0 -6,3.5 2,3.5 2,8.5 -6,8.5 -6,12"
                    button aria-pressed="true" class="placement-picker__button placement-picker__button--wide is-picked" data-offline="" disabled="" type="button" "Long side forward"
                  div class="placement-picker__choice"
                    div class="placement-picker__picture"
                      svg aria-hidden="true" class="mounting-picker__vehicle" viewBox="0 0 100 160"
                        rect class="mounting-picker__body" height="148" rx="12" width="60" x="20" y="6"
                        path class="mounting-picker__glass" d="M27 26 Q50 14 73 26 L70 36 Q50 28 30 36 Z"
