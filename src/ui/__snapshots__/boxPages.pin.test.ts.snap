exports[`the pages without Web Bluetooth (#735) > draw the same DOM in a browser without it 1`] = `
"div class="menu-page" hidden=""
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Sensor box"
  div class="menu-page__body"
    p class="menu__text" "Web Bluetooth is not supported in this browser."
    p class="menu__text" "To connect a sensor box, open Libell in Chrome or Edge on Android or on a computer. The phone’s own sensor works here as usual.""
`;

exports[`the pages without Web Bluetooth (#735) > draw the same DOM on iOS 1`] = `
"div class="menu-page" hidden=""
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Sensor box"
  div class="menu-page__body"
    p class="menu__text" "Safari can't connect to Bluetooth sensors directly, but there's a workaround:"
    p class="menu__text" "Install \\"Bluefy – Web Bluetooth Browser\\" from the App Store."
    p class="menu__text" "Open Bluefy and allow the Bluetooth permission."
    p class="menu__text" "In Bluefy, go to this same Libell address."
    p class="menu__text" "Open Sensor box here again — it works like on Android."
    a class="menu__link" href="https://apps.apple.com/search?term=bluefy" rel="noopener" target="_blank" "Find Bluefy in the App Store"
    p class="menu__text" "Bluefy is a third-party app, not built by Libell — reconnecting when you open the app may need one manual tap there, instead of happening silently.""
`;
