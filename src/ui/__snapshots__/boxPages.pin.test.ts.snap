        label class="settings__field box-password__field"
          span "Box code"
          input autocomplete="off" class="box-password__input" inputmode="numeric" maxlength="4" type="text"
        button class="menu__action" type="button" "Try again"
        p class="menu__text box-password__status" hidden=""
      p class="menu__text box-live"
        span class="box-live__position"
          span class="box-position" hidden=""
            span aria-hidden="true" class="box-position__mark"
            span
        span "Tilt now: —"
      p class="menu__text menu__text--warning" hidden=""
      div
        div class="box-setup"
