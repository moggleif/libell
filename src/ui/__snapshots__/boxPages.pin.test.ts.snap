          span " · Front/back −0.5° · Side/side +1.3°"
        p class="menu__text menu__text--warning" hidden=""
        div
          div class="box-setup"
            div class="box-step is-open"
              button class="box-step__header" type="button"
                span class="box-step__mark" "1"
                span class="box-step__title" "Pick the direction"
              div class="box-step__body"
                div class="mounting-picker"
                  p class="menu__text" "Tap where the box’s back (the screw mount) points."
                  div class="mounting-picker__grid"
                    button aria-label="Points to the front" aria-pressed="false" class="mounting-picker__button mounting-picker__button--front" title="Points to the front" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(0)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the right" aria-pressed="false" class="mounting-picker__button mounting-picker__button--right" title="Points to the right" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(90)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the rear" aria-pressed="false" class="mounting-picker__button mounting-picker__button--rear" title="Points to the rear" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(180)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the left" aria-pressed="false" class="mounting-picker__button mounting-picker__button--left" title="Points to the left" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(270)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    div class="mounting-picker__center"
                      svg aria-hidden="true" class="mounting-picker__vehicle" viewBox="0 0 100 160"
                        rect class="mounting-picker__body" height="148" rx="12" width="60" x="20" y="6"
                        path class="mounting-picker__glass" d="M27 26 Q50 14 73 26 L70 36 Q50 28 30 36 Z"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="118"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="118"
                        text class="mounting-picker__front" text-anchor="middle" x="50" y="52" "FRONT ↑"
                button class="link-button" type="button" "Not sure? Learn it by raising the front"
                div class="learn-mounting" hidden=""
                  h3 class="menu__heading" "Learn the mounting"
                  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
                  p class="menu__text" hidden=""
                  button class="menu__action" type="button" "Learn the mounting"
                  button class="menu__action" hidden="" type="button" "The front is raised"
                  button class="menu__action" hidden="" type="button" "The right side is raised"
                  button class="menu__action menu__action--secondary" hidden="" type="button" "Cancel"
                  p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."
                button class="link-button" hidden="" type="button" "Forget the direction"
            div class="box-step"
              button class="box-step__header" type="button"
                span class="box-step__mark" "2"
                span class="box-step__title" "Zero the vehicle"
              div class="box-step__body" hidden=""
                p class="menu__text" "Level the vehicle with a spirit level, then zero."
                button class="menu__action" type="button" "Zero now"
                div class="box-step__links" hidden=""
                  button class="link-button" disabled="" type="button" "Forget the zero"
                p class="menu__text menu__text--status" hidden=""
                button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
                div class="zero-trim" hidden=""
                  p class="menu__text zero-trim__title" "Fine-tune the zero"
                  p class="menu__text" "Still not quite level? Each tap moves the zero by 0.1°, so the app wants that side higher."
                  div class="zero-trim__buttons"
                    button class="menu__action menu__action--secondary" type="button" "Left up"
                    button class="menu__action menu__action--secondary" type="button" "Right up"
                    button class="menu__action menu__action--secondary" type="button" "Front up"
                    button class="menu__action menu__action--secondary" type="button" "Back up"
                  p aria-live="polite" class="menu__text menu__text--status" "Not fine-tuned"
                  button class="link-button" disabled="" type="button" "Reset fine-tuning"
        div class="box-footer"
          div class="box-footer__actions"
            button class="menu__action menu__action--secondary box-disconnect" type="button" "Disconnect"
        details class="menu__detail sensor-status__debug"
          summary class="sensor-status__debug-summary" "Debug info"
          p class="menu__text" "Raw values straight from the box — for troubleshooting if something isn’t working."
          p class="menu__text" "Device ID: device-1"
          p class="menu__text" "Last sample: —"
          p class="menu__text" "Serial number and firmware (raw): Not available yet"
          button class="menu__action" type="button" "Copy debug info"
        details class="menu__detail sensor-status__advanced"
          summary class="sensor-status__debug-summary" "Advanced"
          p class="menu__text" "This browser cannot yet reconnect to the box on its own, so after a restart you pick it in the list again. In Chrome you can turn this on yourself."
          p class="menu__text" "Open chrome://flags, search for “web bluetooth”, set “Use the new permissions backend for Web Bluetooth” to Enabled and tap Relaunch. Then connect the box once."
          button class="menu__action menu__action--secondary" type="button" "Copy chrome://flags""
`;

