// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the Sensorbox pages with the box connected and zeroed (#735) > draw the same DOM 1`] = `
"div class="menu-page"
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Sensor box"
  div class="menu-page__body"
    div class="sensor-card"
      span aria-hidden="true" class="sensor-card__mark" "+"
      div class="sensor-card__text"
        button aria-disabled="true" class="sensor-card__name sensor-row__status-button sensor-row__status-button--plain" type="button"
          span "EasyLevel"
          span aria-hidden="true" class="sensor-row__chevron" hidden="" "›"
        p class="sensor-card__state" hidden=""
        button aria-label="Connect EasyLevel sensor" class="link-button sensor-card__connect" type="button" "Connect"
        div class="box-password" hidden=""
          p class="menu__text menu__text--warning" "The EasyLevel box did not accept its password. Type the box’s four-digit code below and tap Try again. The factory code is 0000. If you don’t know the code, change it in the Xparkle app."
          label class="settings__field box-password__field"
            span "Box code"
            input autocomplete="off" class="box-password__input" inputmode="numeric" maxlength="4" type="text"
          button class="menu__action" type="button" "Try again"
          p class="menu__text box-password__status" hidden=""
    div class="sensor-card is-active"
      span aria-hidden="true" class="sensor-card__mark" "✓"
      div class="sensor-card__text"
        button class="sensor-card__name sensor-row__status-button" type="button"
          span "Xparkle RVS01"
          span aria-hidden="true" class="sensor-row__chevron" "›"
        p class="sensor-card__state" "Connected"
        button aria-label="Connect Xparkle RVS01 sensor" class="link-button sensor-card__connect" hidden="" type="button" "Connect"
        div class="box-password" hidden=""
          p class="menu__text menu__text--warning" "The Xparkle RVS01 box did not accept its password. Type the box’s four-digit code below and tap Try again. The factory code is 0000. If you don’t know the code, change it in the Xparkle app."
          label class="settings__field box-password__field"
            span "Box code"
            input autocomplete="off" class="box-password__input" inputmode="numeric" maxlength="4" type="text"
          button class="menu__action" type="button" "Try again"
          p class="menu__text box-password__status" hidden=""
    p class="menu__text sensor-list__phone" "The phone's own sensor is used when no box is connected."

  div class="menu-page sensor-status-page" hidden=""
    div class="menu-page__header"
      button aria-label="Close menu" class="menu-page__back" type="button" "✕"
      h2 class="menu-page__title" tabindex="-1" "EasyLevel sensor"
    div class="menu-page__body"
      div class="box-header"
        p class="menu__text menu__text--status box-header__state"
          span aria-hidden="true" class="box-header__dot"
          span "Not connected"
        button class="menu__action" type="button" "Connect"
      div class="box-password" hidden=""
        p class="menu__text menu__text--warning" "The EasyLevel box did not accept its password. Type the box’s four-digit code below and tap Try again. The factory code is 0000. If you don’t know the code, change it in the Xparkle app."
        label class="settings__field box-password__field"
          span "Box code"
          input autocomplete="off" class="box-password__input" inputmode="numeric" maxlength="4" type="text"
        button class="menu__action" type="button" "Try again"
        p class="menu__text box-password__status" hidden=""
      p class="menu__text box-live"
        span class="box-live__position"
          span class="box-position" hidden=""
            span aria-hidden="true" class="box-position__mark"
            span
        span "Tilt now: —"
      p class="menu__text menu__text--warning" hidden=""
      div
        div class="box-setup"
          div class="box-step is-done"
            button class="box-step__header" type="button"
              span class="box-step__mark" "✓"
              span class="box-step__title" "Direction set: long side forward"
            div class="box-step__body" hidden=""
              div class="placement-picker"
                p class="menu__text" "One of the box’s arrows (on the lid, or on the circuit board under it) points forward. Which side faces the front?"
                div class="placement-picker__row"
                  div class="placement-picker__choice"
                    div class="placement-picker__picture is-picked"
                      svg aria-hidden="true" class="mounting-picker__vehicle" viewBox="0 0 100 160"
                        rect class="mounting-picker__body" height="148" rx="12" width="60" x="20" y="6"
                        path class="mounting-picker__glass" d="M27 26 Q50 14 73 26 L70 36 Q50 28 30 36 Z"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="118"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="118"
                        text class="mounting-picker__front" text-anchor="middle" x="50" y="52" "FRONT ↑"
                        g transform="translate(50 100)"
                          g class="box-glyph" transform="scale(1.15) rotate(0)"
                            rect class="box-glyph__body" height="22" rx="2" width="44" x="-22" y="-11"
                            rect class="box-glyph__body" height="28" rx="3" width="30" x="-15" y="-14"
                            polygon class="box-glyph__ref" points="4,-12 10,-5 6.5,-5 6.5,0 1.5,0 1.5,-5 -2,-5"
                            polygon class="box-glyph__ref" points="-13,6 -6,0 -6,3.5 2,3.5 2,8.5 -6,8.5 -6,12"
                    button aria-pressed="true" class="placement-picker__button placement-picker__button--wide is-picked" data-offline="" disabled="" type="button" "Long side forward"
                  div class="placement-picker__choice"
                    div class="placement-picker__picture"
                      svg aria-hidden="true" class="mounting-picker__vehicle" viewBox="0 0 100 160"
                        rect class="mounting-picker__body" height="148" rx="12" width="60" x="20" y="6"
                        path class="mounting-picker__glass" d="M27 26 Q50 14 73 26 L70 36 Q50 28 30 36 Z"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="118"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="118"
                        text class="mounting-picker__front" text-anchor="middle" x="50" y="52" "FRONT ↑"
                        g transform="translate(50 100)"
                          g class="box-glyph" transform="scale(1.15) rotate(90)"
                            rect class="box-glyph__body" height="22" rx="2" width="44" x="-22" y="-11"
                            rect class="box-glyph__body" height="28" rx="3" width="30" x="-15" y="-14"
                            polygon class="box-glyph__ref" points="4,-12 10,-5 6.5,-5 6.5,0 1.5,0 1.5,-5 -2,-5"
                            polygon class="box-glyph__ref" points="-13,6 -6,0 -6,3.5 2,3.5 2,8.5 -6,8.5 -6,12"
                    button aria-pressed="false" class="placement-picker__button placement-picker__button--short" data-offline="" disabled="" type="button" "Short side forward"
              button class="link-button" data-offline="" disabled="" type="button" "Not sure? Learn it by raising the front"
              div class="learn-mounting" hidden=""
                h3 class="menu__heading" "Learn the mounting"
                p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
                p class="menu__text" hidden=""
                button class="menu__action" data-offline="" disabled="" type="button" "Learn the mounting"
                button class="menu__action" data-offline="" disabled="" hidden="" type="button" "The front is raised"
                button class="menu__action" data-offline="" disabled="" hidden="" type="button" "The right side is raised"
                button class="menu__action menu__action--secondary" data-offline="" disabled="" hidden="" type="button" "Cancel"
                p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."
              button class="link-button" data-offline="" disabled="" hidden="" type="button" "Forget the direction"
          div class="box-step is-done"
            button class="box-step__header" type="button"
              span class="box-step__mark" "✓"
              span class="box-step__title" "Zeroed"
            div class="box-step__body" hidden=""
              p class="menu__text" hidden="" "Level the vehicle with a spirit level, then zero."
              button class="menu__action" data-offline="" disabled="" type="button" "Zero again"
              div class="box-step__links"
                button class="link-button" data-offline="" disabled="" type="button" "Forget the zero"
              p class="menu__text menu__text--status" hidden=""
              button class="menu__action menu__action--secondary" data-offline="" disabled="" hidden="" type="button" "Undo"
              div class="zero-trim"
                p class="menu__text zero-trim__title" "Fine-tune the zero"
                p class="menu__text" "Still not quite level? Each tap moves the zero by 0.1°, so the app wants that side higher."
                div class="zero-trim__buttons"
                  button class="menu__action menu__action--secondary" data-offline="" disabled="" type="button" "Left up"
                  button class="menu__action menu__action--secondary" data-offline="" disabled="" type="button" "Right up"
                  button class="menu__action menu__action--secondary" data-offline="" disabled="" type="button" "Front up"
                  button class="menu__action menu__action--secondary" data-offline="" disabled="" type="button" "Back up"
                p aria-live="polite" class="menu__text menu__text--status" "Not fine-tuned"
                button class="link-button" disabled="" type="button" "Reset fine-tuning"
      div class="box-footer"
        div class="box-footer__actions" hidden=""
          button class="menu__action menu__action--secondary box-disconnect" type="button" "Disconnect"
      details class="menu__detail sensor-status__debug" hidden=""
        summary class="sensor-status__debug-summary" "Debug info"
        p class="menu__text" "Raw values straight from the box — for troubleshooting if something isn’t working."
        p class="menu__text" "Temperature: Not available yet"
        p class="menu__text"
        p class="menu__text"
        p class="menu__text"
        p class="menu__text"
        p class="menu__text"
        button class="menu__action" type="button" "Copy debug info"
        p class="settings__hint" "Experimental: only try this if your box’s connection is unreliable. Adds a fixed pause after connecting, before the app starts reading from it."
        label class="settings__field"
          span "Enable connect delay"
          input class="settings__checkbox" type="checkbox"
        label class="settings__field"
          span "Delay (ms)"
          input disabled="" max="5000" min="0" step="50" type="number"
      details class="menu__detail sensor-status__advanced"
        summary class="sensor-status__debug-summary" "Advanced"
        p class="menu__text" "This browser cannot yet reconnect to the box on its own, so after a restart you pick it in the list again. In Chrome you can turn this on yourself."
        p class="menu__text" "Open chrome://flags, search for “web bluetooth”, set “Use the new permissions backend for Web Bluetooth” to Enabled and tap Relaunch. Then connect the box once."
        button class="menu__action menu__action--secondary" type="button" "Copy chrome://flags"

    div class="menu-page sensor-status-page"
      div class="menu-page__header"
        button aria-label="Close menu" class="menu-page__back" type="button" "✕"
        h2 class="menu-page__title" tabindex="-1" "Xparkle RVS01 sensor"
      div class="menu-page__body"
        div class="box-header"
          p class="menu__text menu__text--status box-header__state is-connected"
            span aria-hidden="true" class="box-header__dot"
            span "Connected · battery 72 %"
          button class="menu__action" hidden="" type="button" "Reconnect"
        div class="box-password" hidden=""
          p class="menu__text menu__text--warning" "The Xparkle RVS01 box did not accept its password. Type the box’s four-digit code below and tap Try again. The factory code is 0000. If you don’t know the code, change it in the Xparkle app."
          label class="settings__field box-password__field"
            span "Box code"
            input autocomplete="off" class="box-password__input" inputmode="numeric" maxlength="4" type="text"
          button class="menu__action" type="button" "Try again"
          p class="menu__text box-password__status" hidden=""
        p class="menu__text box-live"
          span class="box-live__position"
            span class="box-position is-done"
              span aria-hidden="true" class="box-position__mark" "✓ "
              span "Stands upright"
          span " · Front/back −0.5° · Side/side +1.3°"
        p class="menu__text menu__text--warning" hidden=""
        div
          div class="box-setup"
            div class="box-step is-open"
              button class="box-step__header" type="button"
                span class="box-step__mark" "1"
                span class="box-step__title" "Pick the direction"
              div class="box-step__body"
                div class="mounting-picker"
                  p class="menu__text" "Tap where the box’s back (the screw mount) points."
                  div class="mounting-picker__grid"
                    button aria-label="Points to the front" aria-pressed="false" class="mounting-picker__button mounting-picker__button--front" title="Points to the front" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(0)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the right" aria-pressed="false" class="mounting-picker__button mounting-picker__button--right" title="Points to the right" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(90)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the rear" aria-pressed="false" class="mounting-picker__button mounting-picker__button--rear" title="Points to the rear" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(180)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    button aria-label="Points to the left" aria-pressed="false" class="mounting-picker__button mounting-picker__button--left" title="Points to the left" type="button"
                      svg aria-hidden="true" viewBox="-22 -22 44 44"
                        g class="box-glyph" transform="rotate(270)"
                          rect class="box-glyph__body" height="12" width="32" x="-16" y="-6"
                          rect class="box-glyph__ref" height="4" width="32" x="-16" y="-6"
                          polygon class="box-glyph__ref" points="0,-13 -4,-8 4,-8"
                    div class="mounting-picker__center"
                      svg aria-hidden="true" class="mounting-picker__vehicle" viewBox="0 0 100 160"
                        rect class="mounting-picker__body" height="148" rx="12" width="60" x="20" y="6"
                        path class="mounting-picker__glass" d="M27 26 Q50 14 73 26 L70 36 Q50 28 30 36 Z"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="30"
                        rect class="mounting-picker__wheel" height="18" width="7" x="13" y="118"
                        rect class="mounting-picker__wheel" height="18" width="7" x="80" y="118"
                        text class="mounting-picker__front" text-anchor="middle" x="50" y="52" "FRONT ↑"
                button class="link-button" type="button" "Not sure? Learn it by raising the front"
                div class="learn-mounting" hidden=""
                  h3 class="menu__heading" "Learn the mounting"
                  p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
                  p class="menu__text" hidden=""
                  button class="menu__action" type="button" "Learn the mounting"
                  button class="menu__action" hidden="" type="button" "The front is raised"
                  button class="menu__action" hidden="" type="button" "The right side is raised"
                  button class="menu__action menu__action--secondary" hidden="" type="button" "Cancel"
                  p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."
                button class="link-button" hidden="" type="button" "Forget the direction"
            div class="box-step is-done"
              button class="box-step__header" type="button"
                span class="box-step__mark" "✓"
                span class="box-step__title" "Zeroed"
              div class="box-step__body" hidden=""
                p class="menu__text" hidden="" "Level the vehicle with a spirit level, then zero."
                button class="menu__action" type="button" "Zero again"
                div class="box-step__links" hidden=""
                  button class="link-button" type="button" "Forget the zero"
                p class="menu__text menu__text--status" hidden=""
                button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
                div class="zero-trim"
                  p class="menu__text zero-trim__title" "Fine-tune the zero"
                  p class="menu__text" "Still not quite level? Each tap moves the zero by 0.1°, so the app wants that side higher."
                  div class="zero-trim__buttons"
                    button class="menu__action menu__action--secondary" type="button" "Left up"
                    button class="menu__action menu__action--secondary" type="button" "Right up"
                    button class="menu__action menu__action--secondary" type="button" "Front up"
                    button class="menu__action menu__action--secondary" type="button" "Back up"
                  p aria-live="polite" class="menu__text menu__text--status" "Not fine-tuned"
                  button class="link-button" disabled="" type="button" "Reset fine-tuning"
        div class="box-footer"
          div class="box-footer__actions"
            button class="menu__action menu__action--secondary box-disconnect" type="button" "Disconnect"
        details class="menu__detail sensor-status__debug"
          summary class="sensor-status__debug-summary" "Debug info"
          p class="menu__text" "Raw values straight from the box — for troubleshooting if something isn’t working."
          p class="menu__text" "Device ID: device-1"
          p class="menu__text" "Last sample: —"
          p class="menu__text" "Serial number and firmware (raw): Not available yet"
          button class="menu__action" type="button" "Copy debug info"
        details class="menu__detail sensor-status__advanced"
          summary class="sensor-status__debug-summary" "Advanced"
          p class="menu__text" "This browser cannot yet reconnect to the box on its own, so after a restart you pick it in the list again. In Chrome you can turn this on yourself."
          p class="menu__text" "Open chrome://flags, search for “web bluetooth”, set “Use the new permissions backend for Web Bluetooth” to Enabled and tap Relaunch. Then connect the box once."
          button class="menu__action menu__action--secondary" type="button" "Copy chrome://flags""
`;

exports[`the Sensorbox pages with the box connection lost (#735) > draw the same DOM 1`] = `
"div class="menu-page"
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Sensor box"
  div class="menu-page__body"
    div class="sensor-card"
      span aria-hidden="true" class="sensor-card__mark" "+"
      div class="sensor-card__text"
        button aria-disabled="true" class="sensor-card__name sensor-row__status-button sensor-row__status-button--plain" type="button"
          span "EasyLevel"
          span aria-hidden="true" class="sensor-row__chevron" hidden="" "›"
        p class="sensor-card__state" hidden=""
        button aria-label="Connect EasyLevel sensor" class="link-button sensor-card__connect" type="button" "Connect"
