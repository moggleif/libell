                    button aria-pressed="false" class="placement-picker__button placement-picker__button--short" data-offline="" disabled="" type="button" "Short side forward"
              button class="link-button" data-offline="" disabled="" type="button" "Not sure? Learn it by raising the front"
              div class="learn-mounting" hidden=""
                h3 class="menu__heading" "Learn the mounting"
                p class="menu__text" "Libell learns the direction from two lifts: first the front, then the right side."
                p class="menu__text" hidden=""
                button class="menu__action" data-offline="" disabled="" type="button" "Learn the mounting"
                button class="menu__action" data-offline="" disabled="" hidden="" type="button" "The front is raised"
                button class="menu__action" data-offline="" disabled="" hidden="" type="button" "The right side is raised"
                button class="menu__action menu__action--secondary" data-offline="" disabled="" hidden="" type="button" "Cancel"
                p class="menu__text menu__text--status" "No mounting learned — the box’s own directions are used."
              button class="link-button" data-offline="" disabled="" hidden="" type="button" "Forget the direction"
