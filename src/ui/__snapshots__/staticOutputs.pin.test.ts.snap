<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "applicationCategory": "UtilitiesApplication",
      "description": "Una app gratuïta que mostra quines rodes de l’autocaravana o la caravana cal pujar i a quin graó de la rampa. Fa servir el mòbil o una caixa sensora i funciona sense connexió.",
