exports[`the static pages in nb > keeps the privacy policy 1`] = `
"<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Personvernerklæring for Libell</title>
<meta name="description" content="Libell er et fritt åpen kildekode-prosjekt. Det finnes ingen kontoer, ingen reklame og ingen sporing, og ingen samler inn opplysninger om deg.">
<link rel="stylesheet" href="/page.css">
<link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
</head>
<body>
<main>
<h1>Personvernerklæring for Libell</h1>
<p class="changed">Sist endret 25. oktober 2026</p>
<p>Libell er et fritt åpen kildekode-prosjekt. Det finnes ingen kontoer, ingen reklame og ingen sporing, og ingen samler inn opplysninger om deg.</p>
<h2>Det som lagres på telefonen</h2>
<p>Libell lagrer kjøretøyene dine med mål, innstillinger, kalibreringer, målposisjoner, valgt språk og sensorboksen du sist brukte. Alt ligger i nettleserens lokale lagring på telefonen din. Den fungerer omtrent som informasjonskapsler, men sendes aldri noe sted. Libell trenger dette for å fungere, og derfor finnes det ingen samtykkeboks.</p>
<p>Under Hjelp › Personvern i appen ser du alt som er lagret, og kan slette alt sammen. Du kan også tømme nettstedsdataene i nettleseren.</p>
<h2>Sensorer og Bluetooth</h2>
<p>Telefonens bevegelsessensorer og Bluetooth brukes bare på telefonen og bare til å måle helningen. Måleverdiene forlater aldri telefonen.</p>
<h2>Anonym telling</h2>
<p>For å vite hva som bør bli bedre, kan Libell telle bruken anonymt med GoatCounter. Libell spør deg én gang om det kan telles, og ingenting telles før du har valgt. Statistikken er offentlig.</p>
<h3>Dette telles</h3>
<p>At appen ble åpnet, hvilke funksjoner som brukes, hvilken sensormodell som måler (telefonen eller en modell som EasyLevel eller Xparkle RVS01), appens versjon og språket som er valgt i Libell.</p>
<h3>Dette lagres aldri</h3>
<p>IP-adressen din, landet, enheten, skjermen, operativsystemet eller nettleseren din, kjøretøyets mål, innstillingene dine eller noe annet om deg. Bare valget ditt lagres på telefonen.</p>
<p>Som ved alle forespørsler på internett når telefonens IP-adresse og nettleserens navn GoatCounter. GoatCounter lagrer dem aldri, men holder dem i minnet i høyst åtte timer for å kjenne igjen det samme besøket. GoatCounter drives fra Irland og har serverne sine i Finland og Tyskland, så ingenting forlater EU.</p>
<p>Du kan endre valget ditt når som helst under Hjelp › Personvern. Uten internett sendes ingenting, og ingenting lagres til senere. Hvis nettleseren din ber nettsteder om ikke å spore deg, teller Libell ingenting.</p>
<p>Tellingen bygger på samtykket ditt etter GDPR (artikkel 6 nr. 1 bokstav a): du gir det med valget ditt og kan trekke det tilbake når som helst. Siden ingenting som kan identifisere deg lagres, finnes det ingenting om deg å vise eller slette. Du kan klage til datatilsynet i landet ditt.</p>
<h2>Det du selv velger å dele</h2>
<p>Under Hjelp › Tilbakemelding kan du åpne en ferdig sak på GitHub, som du selv publiserer med din egen GitHub-konto. Saken er offentlig. I tillegg til teksten din inneholder den appens versjon, skjermstørrelse, tidspunkt og nettleserens navn, og du ser alt før du publiserer.</p>
<p>«Del til en annen telefon» lager en lenke med kjøretøyets mål, uten kalibrering. Lenken havner bare der du selv sender den.</p>
<h2>Nettstedet</h2>
<p>Libell ligger på GitHub Pages. Som alle nettverter ser GitHub IP-adressen din når siden lastes. Libell har ikke tilgang til GitHubs logger.</p>
<h2>Hvem som står bak Libell</h2>
<p>Libell tilhører sitt åpen kildekode-prosjekt, ikke en person eller et selskap. Det er gratis og fritt å bruke som du vil under MIT-lisensen, og leveres som det er, uten garanti.</p>
<h2>Spørsmål og endringer</h2>
<p>Still spørsmålene dine som en sak på GitHub. Når Libell endrer hva som lagres eller sendes, oppdateres denne siden samtidig.</p>
<p><a href="https://github.com/moggleif/libell/issues">Saker på GitHub</a> · <a href="https://libell.goatcounter.com">Se statistikken</a></p>
<p><a href="/">Åpne Libell</a></p>
<h2>Andre språk</h2>
<ul class="languages">
<li><a href="/privacy/ca/" hreflang="ca" lang="ca">Català</a></li>
<li><a href="/privacy/cs/" hreflang="cs" lang="cs">Čeština</a></li>
<li><a href="/privacy/da/" hreflang="da" lang="da">Dansk</a></li>
<li><a href="/privacy/de/" hreflang="de" lang="de">Deutsch</a></li>
<li><a href="/privacy/et/" hreflang="et" lang="et">Eesti</a></li>
<li><a href="/privacy/en/" hreflang="en" lang="en">English</a></li>
<li><a href="/privacy/es/" hreflang="es" lang="es">Español</a></li>
<li><a href="/privacy/fr/" hreflang="fr" lang="fr">Français</a></li>
<li><a href="/privacy/hr/" hreflang="hr" lang="hr">Hrvatski</a></li>
<li><a href="/privacy/is/" hreflang="is" lang="is">Íslenska</a></li>
<li><a href="/privacy/it/" hreflang="it" lang="it">Italiano</a></li>
<li><a href="/privacy/lv/" hreflang="lv" lang="lv">Latviešu</a></li>
<li><a href="/privacy/lt/" hreflang="lt" lang="lt">Lietuvių</a></li>
<li><a href="/privacy/hu/" hreflang="hu" lang="hu">Magyar</a></li>
<li><a href="/privacy/nl/" hreflang="nl" lang="nl">Nederlands</a></li>
<li><a href="/privacy/pl/" hreflang="pl" lang="pl">Polski</a></li>
<li><a href="/privacy/pt/" hreflang="pt" lang="pt">Português</a></li>
<li><a href="/privacy/ro/" hreflang="ro" lang="ro">Română</a></li>
<li><a href="/privacy/sk/" hreflang="sk" lang="sk">Slovenčina</a></li>
<li><a href="/privacy/sl/" hreflang="sl" lang="sl">Slovenščina</a></li>
<li><a href="/privacy/fi/" hreflang="fi" lang="fi">Suomi</a></li>
<li><a href="/privacy/sv/" hreflang="sv" lang="sv">Svenska</a></li>
<li><a href="/privacy/tr/" hreflang="tr" lang="tr">Türkçe</a></li>
</ul>
</main>
</body>
</html>
"
`;

