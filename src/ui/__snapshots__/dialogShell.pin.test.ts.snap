        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="3 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "3 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "Sound"
    div class="onboarding__body"
      form class="settings__form"
        label class="settings__field"
          span "Chime when level"
          input class="settings__checkbox" type="checkbox"
        label class="settings__field"
          span "Continuous audio guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "The beep gets faster and higher the closer you get to level."
        label class="settings__field"
          span "Spoken guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "Spoken guidance does not work on this phone: it has no English voice that works offline. The tones work as usual."
    div class="onboarding__nav onboarding__nav--modern"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="4 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "4 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "What are you leveling?"
    div class="onboarding__body"
      p class="onboarding__text--modern" "Choose your vehicle — the rest of this guide matches it."
      div class="onboarding__source"
        label class="onboarding__source-option"
          input class="onboarding__source-radio" name="onboarding-vehicle" type="radio" value="motorhome"
          span "Motorhome"
        label class="onboarding__source-option"
          input class="onboarding__source-radio" name="onboarding-vehicle" type="radio" value="caravan"
          span "Caravan"
    div class="onboarding__nav onboarding__nav--modern"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="5 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "5 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "Place the phone like this"
    div class="onboarding__body"
      svg aria-label="Place the phone like this" class="illu" role="img" viewBox="0 0 200 150"
        path class="illu__accent" d="M100 6 L92 20 L97 20 L97 30 L103 30 L103 20 L108 20 Z"
        rect class="illu__body" height="106" rx="14" width="80" x="60" y="36"
        path class="illu__windshield" d="M70.4 46.6 Q100 38.12 129.6 46.6 L129.6 56.14 Q100 50.84 70.4 56.14 Z"
        rect class="illu__phone" height="48" rx="5" width="28" x="86" y="66"
        rect class="illu__screen" height="30" rx="2" width="16" x="92" y="72"
        path class="illu__accent" d="M100 62 L96 68 L104 68 Z"
      p class="onboarding__text--modern" "Lay the phone flat in the vehicle, top toward the front, in the same spot every time.\\nWith a sensor box it does not matter how the phone lies."
      div class="onboarding__legend"
        div class="onboarding__legend-row"
          span aria-hidden="true" class="onboarding__legend-swatch onboarding__legend-swatch--ok" "✓"
          span class="onboarding__legend-text" "Green ✓ — that wheel is level."
        div class="onboarding__legend-row"
          span aria-hidden="true" class="onboarding__legend-swatch onboarding__legend-swatch--up" "↑"
          span class="onboarding__legend-text" "Orange ↑ — drive that wheel up onto the step shown."
        div class="onboarding__legend-row"
          span aria-hidden="true" class="onboarding__legend-swatch onboarding__legend-swatch--no" "✕"
          span class="onboarding__legend-text" "Red ✕ — no step is enough; move to a flatter spot."
        div class="onboarding__legend-row"
          span aria-hidden="true" class="onboarding__legend-swatch onboarding__legend-swatch--dim" "–"
          span class="onboarding__legend-text" "Gray – — no ramp at that wheel; the figure shows how much it lacks."
    div class="onboarding__nav onboarding__nav--modern"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="6 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "6 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "The measurements"
    div class="onboarding__body"
      svg aria-label="The measurements" class="illu" role="img" viewBox="0 0 200 160"
        rect class="illu__body" height="136" rx="14" width="90" x="55" y="12"
        path class="illu__windshield" d="M66.7 25.6 Q100 14.72 133.3 25.6 L133.3 37.84 Q100 31.040000000000003 66.7 37.84 Z"
        rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="30"
        rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="30"
        rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="116"
        rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="116"
        line class="illu__measure" x1="100" x2="100" y1="43" y2="129"
        line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="43" y2="43"
        line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="129" y2="129"
      form class="settings__form"
        p class="settings__hint" "They're in the registration document. A few cm off doesn't matter."
        label class="settings__field"
          span "Wheelbase (mm)"
          input inputmode="decimal" min="10" name="wheelbaseMm" step="10" type="number"
        label class="settings__field"
          span "Track width front (mm)"
          input inputmode="decimal" min="10" name="trackWidthFrontMm" step="10" type="number"
        label class="settings__field"
          span "Track width rear (mm)"
          input inputmode="decimal" min="10" name="trackWidthRearMm" step="10" type="number"
    div class="onboarding__nav onboarding__nav--modern"
      p class="onboarding__skip-hint" "Skip, and the default measurements are used; ⚠ Measurements stays lit until you save yours."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
        button class="menu__action menu__action--secondary onboarding__skip--modern" type="button" "Skip"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="7 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "7 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "Ramps"
    div class="onboarding__body"
      form class="settings__form"
        p class="settings__hint" "The app picks where your ramps do the most good."
        div class="settings__field settings__field--wide"
          span "Ramp step heights (mm)"
          div class="steps__ramp"
            span class="menu__text" "Ready-made ramp"
            select class="settings__select"
              option value="" "Custom set"
              option value="stepless" "Stepless wedge"
              option value="Thule Levelers" "Thule Levelers (44/78/112 mm)"
              option value="Fiamma Level Up" "Fiamma Level Up (40/70/100 mm)"
              option value="Fiamma Level Up Premium" "Fiamma Level Up Premium (70/130/170 mm)"
              option value="Milenco Triple Level" "Milenco Triple Level (40/80/120 mm)"
              option value="Milenco Trident Level" "Milenco Trident Level (40/110/170 mm)"
              option value="Milenco Quattro Level" "Milenco Quattro Level (40/80/120/160 mm)"
              option value="Milenco Quattro 3 Level" "Milenco Quattro 3 Level (40/90/130/178 mm)"
              option value="Froli trappkil XL" "Froli trappkil XL (65/115 mm)"
              option value="Froli kompaktkil" "Froli kompaktkil (50/100/150 mm)"
              option value="Biltema nivåkloss" "Biltema nivåkloss (40/70/100 mm)"
              option value="Biltema byggbar nivåkloss" "Biltema byggbar nivåkloss (25/50/75/100/125 mm)"
              option value="Brunner Equalizer XL" "Brunner Equalizer XL (45/80/110 mm)"
              option value="Fiamma Jumbo" "Fiamma Jumbo (40/70/100 mm)"
              option value="Hamron nivåklossar" "Hamron nivåklossar (40/70/100 mm)"
              option value="Briv nivåklossar" "Briv nivåklossar (40/70/100 mm)"
              option value="TrutzHolm Auffahrkeil 5 t" "TrutzHolm Auffahrkeil 5 t (40/70/100 mm)"
              option value="Lippert LEVEL9" "Lippert LEVEL9 (20/40/60/80/100/120/140/160/180 mm)"
              option value="Andersen Camper Leveler" "Andersen Camper Leveler (stepless, max 101 mm)"
          div class="steps__chips"
            span class="steps__chip"
              span "44 mm"
              button aria-label="Remove 44 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "78 mm"
              button aria-label="Remove 78 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "112 mm"
              button aria-label="Remove 112 mm" class="steps__chip-remove" type="button" "−"
          div class="steps__add"
            input aria-label="New step height (mm)" inputmode="decimal" placeholder="40" type="number"
            button class="menu__action menu__action--secondary steps__add-btn" type="button" "+ Add step"
        label class="settings__field"
          span "Number of ramps"
          select class="settings__select"
            option value="1" "1"
            option value="2" "2"
            option value="3" "3"
            option value="4" "4"
    div class="onboarding__nav onboarding__nav--modern"
      p class="onboarding__skip-hint" "Skip, and the default ramps are used. You can pick yours later in Settings."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
        button class="menu__action menu__action--secondary onboarding__skip--modern" type="button" "Skip"
      button class="menu__action onboarding__next--modern" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="8 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar onboarding__bar--active"
        span aria-hidden="true" class="onboarding__bars-text" "8 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "Calibrate the phone"
      span class="calibration-card__pill calibration-card__pill--pending" "NOT DONE"
    div class="onboarding__body"
      div class="calibration-card"
        p class="calibration-card__body" "Put the phone on a surface you know is level, then tap Calibrate now. The current tilt becomes the zero point."
        button class="menu__action" type="button" "Calibrate now"
        p class="calibration-card__body" "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
        button class="menu__action" type="button" "Calibrate by flipping"
        p class="menu__text menu__text--status"
        button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
        p class="menu__text menu__text--status" "Not calibrated — using the raw sensor."
        button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
        p class="calibration-card__body" "You zero the vehicle the first time you park on level ground. ⚠ Zero reminds you until it’s done."
    div class="onboarding__nav onboarding__nav--modern"
      p class="onboarding__skip-hint" "No flat surface right now? Tap Next; ⚠ Calibrate reminds you until it’s done."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary onboarding__back--modern" type="button" "Back"
      button class="menu__action onboarding__next--modern" type="button" "Done""
`;
