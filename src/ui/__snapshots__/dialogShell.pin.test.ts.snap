exports[`the dialog shell of the counting choice (#699) (#710) > draws the same DOM when it opens 1`] = `
"div aria-labelledby="counting-choice-heading" aria-modal="true" class="intro counting-choice" role="dialog"
  div class="intro__card"
    div class="intro__body"
      h2 class="intro__title" id="counting-choice-heading" tabindex="-1" "Would you like to help make Libell better?"
      p class="intro__text" "Libell can count use anonymously, so we know what to improve."
        a class="menu__link" href="https://libell.goatcounter.com" rel="noopener" target="_blank" "See the statistics"
      p class="settings__section" "What is counted"
      p class="intro__text" "That the app was opened, which features are used, which sensor measures (the phone or a model such as EasyLevel or Xparkle RVS01), the app version and the language chosen in Libell."
      p class="settings__section" "What is never saved"
      p class="intro__text" "Your IP address, country, device, screen, operating system or browser, your vehicle’s measurements, your settings, or anything else about you. Only your choice is kept on your phone." "You can change your choice any time under Help › Privacy."
    div class="intro__nav"
      button class="menu__action" type="button" "Yes, count anonymously"
      button class="menu__action" type="button" "No thanks""
`;

exports[`the dialog shell of the incoming vehicle setup (R41) (#710) > draws the same DOM when it opens 1`] = `
"div aria-labelledby="incoming-setup-heading" aria-modal="true" class="incoming-setup" role="dialog"
  div class="incoming-setup__card"
    h2 class="incoming-setup__heading" id="incoming-setup-heading" tabindex="-1" "Incoming vehicle setup"
    p class="incoming-setup__intro" "A family member shared these vehicle measurements with you:"
    dl class="incoming-setup__list"
      dt "Vehicle"
      dd "Motorhome"
      dt "Rear axle"
      dd "Single"
      dt "Wheelbase"
      dd "3800 mm"
      dt "Track width front"
      dd "1800 mm"
      dt "Track width rear"
      dd "1900 mm"
      dt "Ramp step heights"
      dd "40 mm, 80 mm"
      dt "Number of ramps"
      dd "2"
      dt "Drain side"
      dd "Left, middle"
    p class="incoming-setup__reminder" "This does not include any calibration — you'll still need to calibrate on this phone."
    div class="incoming-setup__actions"
      button class="menu__action menu__action--secondary" type="button" "Not now"
      button class="menu__action menu__action--secondary" type="button" "Replace the current vehicle"
      button class="menu__action" type="button" "Add as a new vehicle""
`;

exports[`the dialog shell of the intro (#691) (#710) > draws the same DOM when it opens 1`] = `
"div aria-labelledby="intro-heading" aria-modal="true" class="intro" role="dialog"
  div class="intro__card"
    div class="intro__body"
      svg aria-hidden="true" aria-label="" class="illu" role="img" viewBox="0 0 200 150"
        path class="illu__accent" d="M100 6 L92 20 L97 20 L97 30 L103 30 L103 20 L108 20 Z"
        rect class="illu__body" height="106" rx="14" width="80" x="60" y="36"
        path class="illu__windshield" d="M70.4 46.6 Q100 38.12 129.6 46.6 L129.6 56.14 Q100 50.84 70.4 56.14 Z"
        rect class="illu__phone" height="48" rx="5" width="28" x="86" y="66"
        rect class="illu__screen" height="30" rx="2" width="16" x="92" y="72"
        path class="illu__accent" d="M100 62 L96 68 L104 68 Z"
      h2 class="intro__title" id="intro-heading" tabindex="-1" "Welcome to Libell"
      p class="intro__text" "Libell helps you level your motorhome or caravan with the phone you already have, without guessing."
      p class="intro__text" "Lay the phone flat in the vehicle and Libell shows which wheels to raise, and by how much."
    div class="intro__nav"
      button class="menu__action" type="button" "Get started"
      button class="menu__action menu__action--secondary" hidden="" type="button" "Install"
      p class="intro__text intro__hint" hidden="" "Tap Share, then \\"Add to Home Screen\\"."
      button class="intro__later" type="button" "Look around first""
`;

exports[`the dialog shell of the onboarding wizard (#710) > draws the same DOM when it opens 1`] = `
"div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      div class="onboarding__progress-wrap"
        div aria-label="1 / 8" class="onboarding__bars" role="img"
          span class="onboarding__bar onboarding__bar--active"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
          span class="onboarding__bar"
        span aria-hidden="true" class="onboarding__bars-text" "1 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title onboarding__title--modern" id="onboarding-heading" tabindex="-1" "Language"
    div class="onboarding__body"
      form class="settings__form"
        label class="settings__field"
          span "Language"
          select class="settings__select"
            option value="auto" "Automatic (device language)"
            option value="ca" "Català"
            option value="cs" "Čeština"
            option value="da" "Dansk"
            option value="de" "Deutsch"
            option value="et" "Eesti"
            option value="en" "English"
            option value="es" "Español"
            option value="fr" "Français"
            option value="hr" "Hrvatski"
            option value="is" "Íslenska"
            option value="it" "Italiano"
            option value="lv" "Latviešu"
            option value="lt" "Lietuvių"
            option value="hu" "Magyar"
            option value="nl" "Nederlands"
            option value="nb" "Norsk bokmål"
            option value="pl" "Polski"
            option value="pt" "Português"
            option value="ro" "Română"
            option value="sk" "Slovenčina"
            option value="sl" "Slovenščina"
            option value="fi" "Suomi"
            option value="sv" "Svenska"
            option value="tr" "Türkçe"
    div class="onboarding__nav onboarding__nav--modern"
      button class="menu__action onboarding__next--modern" type="button" "Next""
`;

exports[`the onboarding wizard in classic (#735) > draws the same DOM at every step 1`] = `
"div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "1 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Language"
    div class="onboarding__body"
      form class="settings__form"
        label class="settings__field"
          span "Language"
          select class="settings__select"
            option value="auto" "Automatic (device language)"
            option value="ca" "Català"
            option value="cs" "Čeština"
            option value="da" "Dansk"
            option value="de" "Deutsch"
            option value="et" "Eesti"
            option value="en" "English"
            option value="es" "Español"
            option value="fr" "Français"
            option value="hr" "Hrvatski"
            option value="is" "Íslenska"
            option value="it" "Italiano"
            option value="lv" "Latviešu"
            option value="lt" "Lietuvių"
            option value="hu" "Magyar"
            option value="nl" "Nederlands"
            option value="nb" "Norsk bokmål"
            option value="pl" "Polski"
            option value="pt" "Português"
            option value="ro" "Română"
            option value="sk" "Slovenčina"
            option value="sl" "Slovenščina"
            option value="fi" "Suomi"
            option value="sv" "Svenska"
            option value="tr" "Türkçe"
    div class="onboarding__nav"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "2 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Appearance"
    div class="onboarding__body"
      form class="settings__form"
        label class="settings__field"
          span "Theme"
          select class="settings__select"
            option value="system" "Follow the phone"
            option value="light" "Light"
            option value="dark" "Dark"
        label class="settings__field"
          span "Appearance"
          select class="settings__select"
            option value="classic" "Classic"
            option value="modern" "Modern"
            option value="glossy" "Glossy"
    div class="onboarding__nav"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "3 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Sound"
    div class="onboarding__body"
      form class="settings__form"
        label class="settings__field"
          span "Chime when level"
          input class="settings__checkbox" type="checkbox"
        label class="settings__field"
          span "Continuous audio guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "The beep gets faster and higher the closer you get to level."
        label class="settings__field"
          span "Spoken guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "Spoken guidance does not work on this phone: it has no English voice that works offline. The tones work as usual."
    div class="onboarding__nav"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "4 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "What are you leveling?"
    div class="onboarding__body"
      p class="menu__text" "Choose your vehicle — the rest of this guide matches it."
      div class="onboarding__source"
        label class="onboarding__source-option"
          input class="onboarding__source-radio" name="onboarding-vehicle" type="radio" value="motorhome"
          span "Motorhome"
        label class="onboarding__source-option"
          input class="onboarding__source-radio" name="onboarding-vehicle" type="radio" value="caravan"
          span "Caravan"
    div class="onboarding__nav"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "5 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Place the phone like this"
    div class="onboarding__body"
      svg aria-label="Place the phone like this" class="illu" role="img" viewBox="0 0 200 150"
        path class="illu__accent" d="M100 6 L92 20 L97 20 L97 30 L103 30 L103 20 L108 20 Z"
        rect class="illu__body" height="106" rx="14" width="80" x="60" y="36"
        path class="illu__windshield" d="M70.4 46.6 Q100 38.12 129.6 46.6 L129.6 56.14 Q100 50.84 70.4 56.14 Z"
        rect class="illu__phone" height="48" rx="5" width="28" x="86" y="66"
        rect class="illu__screen" height="30" rx="2" width="16" x="92" y="72"
        path class="illu__accent" d="M100 62 L96 68 L104 68 Z"
      p class="menu__text" "Lay the phone flat in the vehicle, top toward the front, in the same spot every time.\\nWith a sensor box it does not matter how the phone lies."
      svg aria-label="Reading the screen" class="illu" role="img" viewBox="0 0 260 70"
        rect class="illu__wheel illu__wheel--ok" height="46" rx="9" width="28" x="30" y="12"
        text class="illu__glyph" x="44" y="42" "✓"
        rect class="illu__wheel illu__wheel--up" height="46" rx="9" width="28" x="90" y="12"
        text class="illu__glyph" x="104" y="42" "↑"
        rect class="illu__wheel illu__wheel--no" height="46" rx="9" width="28" x="150" y="12"
        text class="illu__glyph" x="164" y="42" "✕"
        rect class="illu__wheel illu__wheel--dim" height="46" rx="9" width="28" x="210" y="12"
        text class="illu__glyph" x="224" y="42" "–"
      p class="menu__text" "Green ✓: done, nothing to do.\\nOrange ↑: drive that wheel up onto the step shown next to it.\\nRed ✕: your ramps are not enough here. Move the vehicle.\\nGray –: no ramp at that wheel. The figure shows how much it lacks, if you want to put something else under it.\\nWhen the bubble rests in the middle, you are level."
    div class="onboarding__nav"
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "6 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "The measurements"
    div class="onboarding__body"
      svg aria-label="The measurements" class="illu" role="img" viewBox="0 0 200 160"
        rect class="illu__body" height="136" rx="14" width="90" x="55" y="12"
        path class="illu__windshield" d="M66.7 25.6 Q100 14.72 133.3 25.6 L133.3 37.84 Q100 31.040000000000003 66.7 37.84 Z"
        rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="30"
        rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="30"
        rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="116"
        rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="116"
        line class="illu__measure" x1="100" x2="100" y1="43" y2="129"
        line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="43" y2="43"
        line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="129" y2="129"
      form class="settings__form"
        p class="settings__hint" "They're in the registration document. A few cm off doesn't matter."
        label class="settings__field"
          span "Wheelbase (mm)"
          input inputmode="decimal" min="10" name="wheelbaseMm" step="10" type="number"
        label class="settings__field"
          span "Track width front (mm)"
          input inputmode="decimal" min="10" name="trackWidthFrontMm" step="10" type="number"
        label class="settings__field"
          span "Track width rear (mm)"
          input inputmode="decimal" min="10" name="trackWidthRearMm" step="10" type="number"
    div class="onboarding__nav"
      p class="onboarding__skip-hint" "Skip, and the default measurements are used; ⚠ Measurements stays lit until you save yours."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
        button class="menu__action menu__action--secondary" type="button" "Skip"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "7 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Ramps"
    div class="onboarding__body"
      form class="settings__form"
        p class="settings__hint" "The app picks where your ramps do the most good."
        div class="settings__field settings__field--wide"
          span "Ramp step heights (mm)"
          div class="steps__ramp"
            span class="menu__text" "Ready-made ramp"
            select class="settings__select"
              option value="" "Custom set"
              option value="stepless" "Stepless wedge"
              option value="Thule Levelers" "Thule Levelers (44/78/112 mm)"
              option value="Fiamma Level Up" "Fiamma Level Up (40/70/100 mm)"
              option value="Fiamma Level Up Premium" "Fiamma Level Up Premium (70/130/170 mm)"
              option value="Milenco Triple Level" "Milenco Triple Level (40/80/120 mm)"
              option value="Milenco Trident Level" "Milenco Trident Level (40/110/170 mm)"
              option value="Milenco Quattro Level" "Milenco Quattro Level (40/80/120/160 mm)"
              option value="Milenco Quattro 3 Level" "Milenco Quattro 3 Level (40/90/130/178 mm)"
              option value="Froli trappkil XL" "Froli trappkil XL (65/115 mm)"
              option value="Froli kompaktkil" "Froli kompaktkil (50/100/150 mm)"
              option value="Biltema nivåkloss" "Biltema nivåkloss (40/70/100 mm)"
              option value="Biltema byggbar nivåkloss" "Biltema byggbar nivåkloss (25/50/75/100/125 mm)"
              option value="Brunner Equalizer XL" "Brunner Equalizer XL (45/80/110 mm)"
              option value="Fiamma Jumbo" "Fiamma Jumbo (40/70/100 mm)"
              option value="Hamron nivåklossar" "Hamron nivåklossar (40/70/100 mm)"
              option value="Briv nivåklossar" "Briv nivåklossar (40/70/100 mm)"
              option value="TrutzHolm Auffahrkeil 5 t" "TrutzHolm Auffahrkeil 5 t (40/70/100 mm)"
              option value="Lippert LEVEL9" "Lippert LEVEL9 (20/40/60/80/100/120/140/160/180 mm)"
              option value="Andersen Camper Leveler" "Andersen Camper Leveler (stepless, max 101 mm)"
          div class="steps__chips"
            span class="steps__chip"
              span "44 mm"
              button aria-label="Remove 44 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "78 mm"
              button aria-label="Remove 78 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "112 mm"
              button aria-label="Remove 112 mm" class="steps__chip-remove" type="button" "−"
          div class="steps__add"
            input aria-label="New step height (mm)" inputmode="decimal" placeholder="40" type="number"
            button class="menu__action menu__action--secondary steps__add-btn" type="button" "+ Add step"
        label class="settings__field"
          span "Number of ramps"
          select class="settings__select"
            option value="1" "1"
            option value="2" "2"
            option value="3" "3"
            option value="4" "4"
    div class="onboarding__nav"
      p class="onboarding__skip-hint" "Skip, and the default ramps are used. You can pick yours later in Settings."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
        button class="menu__action menu__action--secondary" type="button" "Skip"
      button class="menu__action" type="button" "Next"

div aria-labelledby="onboarding-heading" aria-modal="true" class="onboarding" role="dialog"
  div class="onboarding__card"
    div class="onboarding__header"
      p class="onboarding__progress" "8 / 8"
      button aria-label="Close the introduction" class="onboarding__close" type="button" "✕"
    h2 class="onboarding__title" id="onboarding-heading" tabindex="-1" "Calibrate the phone"
    div class="onboarding__body"
      div
        p class="menu__text" "Put the phone on a surface you know is level, then tap Calibrate now. The current tilt becomes the zero point."
        p class="menu__text menu__text--status" "Not calibrated — using the raw sensor."
        button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
        button class="menu__action" type="button" "Calibrate now"
        p class="menu__text" "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
        button class="menu__action" type="button" "Calibrate by flipping"
        p class="menu__text menu__text--status"
        button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
        p class="menu__text" "You zero the vehicle the first time you park on level ground. ⚠ Zero reminds you until it’s done."
    div class="onboarding__nav"
      p class="onboarding__skip-hint" "No flat surface right now? Tap Next; ⚠ Calibrate reminds you until it’s done."
      div class="onboarding__nav-row"
        button class="menu__action menu__action--secondary" type="button" "Back"
      button class="menu__action" type="button" "Done""
`;

