// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the dialog shell of the counting choice (#699) (#710) > draws the same DOM when it opens 1`] = `"<div class="intro counting-choice" role="dialog" aria-modal="true" aria-labelledby="counting-choice-heading"><div class="intro__card"><div class="intro__body"><h2 class="intro__title" id="counting-choice-heading" tabindex="-1">Would you like to help make Libell better?</h2><p class="intro__text">Libell can count use anonymously, so we know what to improve. <a class="menu__link" href="https://libell.goatcounter.com" target="_blank" rel="noopener">See the statistics</a></p><p class="settings__section">What is counted</p><p class="intro__text">That the app was opened, which features are used, which sensor measures (the phone or a model such as EasyLevel or Xparkle RVS01), the app version and the language chosen in Libell.</p><p class="settings__section">What is never saved</p><p class="intro__text">Your IP address, country, device, screen, operating system or browser, your vehicle’s measurements, your settings, or anything else about you. Only your choice is kept on your phone. You can change your choice any time under Help › Privacy.</p></div><div class="intro__nav"><button class="menu__action" type="button">Yes, count anonymously</button><button class="menu__action" type="button">No thanks</button></div></div></div>"`;

exports[`the dialog shell of the incoming vehicle setup (R41) (#710) > draws the same DOM when it opens 1`] = `"<div class="incoming-setup" role="dialog" aria-modal="true" aria-labelledby="incoming-setup-heading"><div class="incoming-setup__card"><h2 id="incoming-setup-heading" class="incoming-setup__heading" tabindex="-1">Incoming vehicle setup</h2><p class="incoming-setup__intro">A family member shared these vehicle measurements with you:</p><dl class="incoming-setup__list"><dt>Vehicle</dt><dd>Motorhome</dd><dt>Rear axle</dt><dd>Single</dd><dt>Wheelbase</dt><dd>3800 mm</dd><dt>Track width front</dt><dd>1800 mm</dd><dt>Track width rear</dt><dd>1900 mm</dd><dt>Ramp step heights</dt><dd>40 mm, 80 mm</dd><dt>Number of ramps</dt><dd>2</dd><dt>Drain side</dt><dd>Left, middle</dd></dl><p class="incoming-setup__reminder">This does not include any calibration — you'll still need to calibrate on this phone.</p><div class="incoming-setup__actions"><button class="menu__action menu__action--secondary" type="button">Not now</button><button class="menu__action menu__action--secondary" type="button">Replace the current vehicle</button><button class="menu__action" type="button">Add as a new vehicle</button></div></div></div>"`;

exports[`the dialog shell of the intro (#691) (#710) > draws the same DOM when it opens 1`] = `"<div class="intro" role="dialog" aria-modal="true" aria-labelledby="intro-heading"><div class="intro__card"><div class="intro__body"><svg viewBox="0 0 200 150" role="img" class="illu" aria-label="" aria-hidden="true"><path d="M100 6 L92 20 L97 20 L97 30 L103 30 L103 20 L108 20 Z" class="illu__accent"></path><rect x="60" y="36" width="80" height="106" rx="14" class="illu__body"></rect><path d="M70.4 46.6 Q100 38.12 129.6 46.6 L129.6 56.14 Q100 50.84 70.4 56.14 Z" class="illu__windshield"></path><rect x="86" y="66" width="28" height="48" rx="5" class="illu__phone"></rect><rect x="92" y="72" width="16" height="30" rx="2" class="illu__screen"></rect><path d="M100 62 L96 68 L104 68 Z" class="illu__accent"></path></svg><h2 class="intro__title" id="intro-heading" tabindex="-1">Welcome to Libell</h2><p class="intro__text">Libell helps you level your motorhome or caravan with the phone you already have, without guessing.</p><p class="intro__text">Lay the phone flat in the vehicle and Libell shows which wheels to raise, and by how much.</p></div><div class="intro__nav"><button class="menu__action" type="button">Get started</button><button class="menu__action menu__action--secondary" type="button" hidden="">Install</button><p class="intro__text intro__hint" hidden="">Tap Share, then "Add to Home Screen".</p><button class="intro__later" type="button">Look around first</button></div></div></div>"`;

exports[`the dialog shell of the onboarding wizard (#710) > draws the same DOM when it opens 1`] = `"<div class="onboarding" role="dialog" aria-modal="true" aria-labelledby="onboarding-heading"><div class="onboarding__card"><div class="onboarding__header"><div class="onboarding__progress-wrap"><div class="onboarding__bars" role="img" aria-label="1 / 8"><span class="onboarding__bar onboarding__bar--active"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span><span class="onboarding__bar"></span></div><span class="onboarding__bars-text" aria-hidden="true">1 / 8</span></div><button type="button" class="onboarding__close" aria-label="Close the introduction">✕</button></div><h2 class="onboarding__title onboarding__title--modern" tabindex="-1" id="onboarding-heading">Language</h2><div class="onboarding__body"><form class="settings__form"><label class="settings__field"><span>Language</span><select class="settings__select"><option value="auto">Automatic (device language)</option><option value="ca">Català</option><option value="cs">Čeština</option><option value="da">Dansk</option><option value="de">Deutsch</option><option value="et">Eesti</option><option value="en">English</option><option value="es">Español</option><option value="fr">Français</option><option value="hr">Hrvatski</option><option value="is">Íslenska</option><option value="it">Italiano</option><option value="lv">Latviešu</option><option value="lt">Lietuvių</option><option value="hu">Magyar</option><option value="nl">Nederlands</option><option value="nb">Norsk bokmål</option><option value="pl">Polski</option><option value="pt">Português</option><option value="ro">Română</option><option value="sk">Slovenčina</option><option value="sl">Slovenščina</option><option value="fi">Suomi</option><option value="sv">Svenska</option><option value="tr">Türkçe</option></select></label></form></div><div class="onboarding__nav onboarding__nav--modern"><button type="button" class="menu__action onboarding__next--modern">Next</button></div></div></div>"`;
