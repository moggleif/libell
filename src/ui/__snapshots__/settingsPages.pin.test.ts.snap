// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the "?" page (#735) > draws the same DOM 1`] = `
"div class="menu-page"
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Help"
  div class="menu-page__body"
    div class="settings__tabs" role="tablist"
      button aria-selected="true" class="settings__tab" data-tab="help" role="tab" type="button" "Help"
      button aria-selected="false" class="settings__tab" data-tab="about" role="tab" type="button" "About"
      button aria-selected="false" class="settings__tab" data-tab="feedback" role="tab" type="button" "Feedback"
      button aria-selected="false" class="settings__tab" data-tab="privacy" role="tab" type="button" "Privacy"
    div class="settings__tabpanel"
      section class="help-topic" data-topic="screen"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-screen" aria-expanded="true" class="help-topic__toggle" type="button" "Reading the screen"
        div class="help-topic__body" id="help-topic-screen"
          p class="menu__text" "The screen shows which wheels to raise and by how much. Step 2 means the second step of your ramp."
          svg aria-label="Reading the screen" class="illu" role="img" viewBox="0 0 260 70"
            rect class="illu__wheel illu__wheel--ok" height="46" rx="9" width="28" x="30" y="12"
            text class="illu__glyph" x="44" y="42" "✓"
            rect class="illu__wheel illu__wheel--up" height="46" rx="9" width="28" x="90" y="12"
            text class="illu__glyph" x="104" y="42" "↑"
            rect class="illu__wheel illu__wheel--no" height="46" rx="9" width="28" x="150" y="12"
            text class="illu__glyph" x="164" y="42" "✕"
            rect class="illu__wheel illu__wheel--dim" height="46" rx="9" width="28" x="210" y="12"
            text class="illu__glyph" x="224" y="42" "–"
          p class="menu__text" "Green ✓: done, nothing to do.\\nOrange ↑: drive that wheel up onto the step shown next to it.\\nRed ✕: your ramps are not enough here. Move the vehicle.\\nGray –: no ramp at that wheel. The figure shows how much it lacks, if you want to put something else under it.\\nWhen the bubble rests in the middle, you are level."
          p class="menu__text" "Caravan: the jockey wheel says Crank up or Crank down, and by how much."
          p class="menu__text" "Drive up, wait until the vehicle is still and look again. Repeat until every wheel is green."
      section class="help-topic" data-topic="place"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-place" aria-expanded="false" class="help-topic__toggle" type="button" "Place the phone like this"
        div class="help-topic__body" hidden="" id="help-topic-place"
          svg aria-label="Place the phone like this" class="illu" role="img" viewBox="0 0 200 150"
            path class="illu__accent" d="M100 6 L92 20 L97 20 L97 30 L103 30 L103 20 L108 20 Z"
            rect class="illu__body" height="106" rx="14" width="80" x="60" y="36"
            path class="illu__windshield" d="M70.4 46.6 Q100 38.12 129.6 46.6 L129.6 56.14 Q100 50.84 70.4 56.14 Z"
            rect class="illu__phone" height="48" rx="5" width="28" x="86" y="66"
            rect class="illu__screen" height="30" rx="2" width="16" x="92" y="72"
            path class="illu__accent" d="M100 62 L96 68 L104 68 Z"
          p class="menu__text" "Lay the phone flat in the vehicle, top toward the front, in the same spot every time.\\nWith a sensor box it does not matter how the phone lies."
      section class="help-topic" data-topic="measures"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-measures" aria-expanded="false" class="help-topic__toggle" type="button" "Enter the measurements"
        div class="help-topic__body" hidden="" id="help-topic-measures"
          div class="illu-pair"
            div class="illu-pair__item"
              p class="illu-pair__caption" "Motorhome"
              svg aria-label="Enter the measurements – Motorhome" class="illu" role="img" viewBox="0 0 200 160"
                rect class="illu__body" height="136" rx="14" width="90" x="55" y="12"
                path class="illu__windshield" d="M66.7 25.6 Q100 14.72 133.3 25.6 L133.3 37.84 Q100 31.040000000000003 66.7 37.84 Z"
                rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="30"
                rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="30"
                rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="116"
                rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="116"
                line class="illu__measure" x1="100" x2="100" y1="43" y2="129"
                line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="43" y2="43"
                line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="129" y2="129"
            div class="illu-pair__item"
              p class="illu-pair__caption" "Caravan"
              svg aria-label="Enter the measurements – Caravan" class="illu" role="img" viewBox="0 0 200 160"
                path class="illu__drawbar" d="M70 60 L100 30 L130 60"
                circle class="illu__wheel" cx="100" cy="30" r="7"
                rect class="illu__body" height="88" rx="14" width="90" x="55" y="60"
                rect class="illu__wheel" height="26" rx="5" width="14" x="38" y="120"
                rect class="illu__wheel" height="26" rx="5" width="14" x="148" y="120"
                line class="illu__measure" x1="100" x2="100" y1="30" y2="133"
                line class="illu__measure illu__measure--dash" x1="45" x2="155" y1="133" y2="133"
          p class="menu__text" "Libell works out how much each wheel must rise from the wheelbase and track width.\\nThey are in the vehicle papers, or measure with a tape.\\nType them in mm, cm or inches, whichever you picked under Show lengths in.\\nOn a caravan, the wheelbase is the distance from the axle to the jockey wheel.\\nWith several vehicles, each keeps its own measurements, ramps, vehicle zero, targets and sensor box; pick one at the top of Vehicle."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Open Vehicle"
      section class="help-topic" data-topic="ramps"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-ramps" aria-expanded="false" class="help-topic__toggle" type="button" "Ramps"
        div class="help-topic__body" hidden="" id="help-topic-ramps"
          p class="menu__text" "The screen tells you which step of your ramp each wheel goes up on, so enter the ramps you carry.\\nPick a ready-made ramp or a custom set, and how many you have. Libell puts them where they help most.\\nFor a ramp with no steps, pick Stepless wedge and enter its height. The screen then says how far to drive up.\\nSet an adjustable ramp such as Lippert LEVEL9 to the right step before you drive up. The line above the vehicle says when to drive off and adjust it."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Open Ramps"
      section class="help-topic" data-topic="calibration"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-calibration" aria-expanded="false" class="help-topic__toggle" type="button" "Calibrate and zero"
        div class="help-topic__body" hidden="" id="help-topic-calibration"
          p class="menu__text" "Two steps make the readings right: calibrate the phone once and zero the vehicle once.\\nCalibrate: lay the phone on a flat surface and tap Calibrate now.\\nZero: level the vehicle with a spirit level, put the phone in its usual place and tap Zero now.\\nWith a sensor box you zero on the box’s page. It needs no calibration.\\nStill not quite level? Fine-tune the zero with Left up, Right up, Front up or Back up in Zero the vehicle.\\nThe ⚠ Calibrate or ⚠ Zero lamp stays on until it is done."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Open Calibrate and zero"
      section class="help-topic" data-topic="sensor"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-sensor" aria-expanded="false" class="help-topic__toggle" type="button" "Sensor box"
        div class="help-topic__body" hidden="" id="help-topic-sensor"
          p class="menu__text" "A sensor box in the vehicle can measure instead of the phone. Libell works with these:\\nXparkle RVS01: stands upright, facing any way.\\nEasyLevel: lies flat, lid up, with one arrow pointing forward.\\nConnect with the sensor icon at the top right. The box’s page then takes you through Pick the direction and Zero the vehicle.\\nIt works in Chrome or Edge on Android or a computer. On iPhone you need the Bluefy browser.\\nIf the box rejects the code, Libell asks for the box’s four-digit code."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Open the sensor box"
      section class="help-topic" data-topic="targets"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-targets" aria-expanded="false" class="help-topic__toggle" type="button" "Targets and sound"
        div class="help-topic__body" hidden="" id="help-topic-targets"
          p class="menu__text" "Save a tilt you want, for example toward the shower drain, and switch between them.\\nCaravan: save the hitch height before you unhitch, and Back to hitch height leads the jockey wheel back to it.\\nWith spoken guidance on, the app says which wheel to raise and how much, so you can level without seeing the phone.\\nThe button in the middle of the bottom bar turns sound on and off."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Open Level"
      section class="help-topic" data-topic="trouble"
        h3 class="help-topic__heading"
          button aria-controls="help-topic-trouble" aria-expanded="false" class="help-topic__toggle" type="button" "If something is wrong"
        div class="help-topic__body" hidden="" id="help-topic-trouble"
          p class="menu__text" "“Measuring…”: the vehicle is rocking. Wait until it is still.\\n“Lay the phone flat to measure”: the phone is tilted too much to measure.\\n“Lost contact with the box”: tap Reconnect and pick the box in the list.\\n“Waiting for the tilt sensor…”: no readings yet. On iPhone, tap Start each time you open the app; otherwise reload.\\n“Motion access was denied”: allow motion & orientation for this site in the browser settings and reload.\\nStill wrong? Write a report under Feedback."
          button class="menu__action menu__action--secondary help-topic__go" type="button" "Write a report"
      button class="menu__action menu__action--secondary" type="button" "Show introduction"
    div class="settings__tabpanel" hidden=""
      p class="menu__text" "Libell helps you level your motorhome or caravan with the phone you already have, without guessing."
      p class="menu__text" "Works fully offline — the network is only used to fetch updates of the app itself."
      p class="menu__text" "Your settings stay on your phone — no account and no tracking. The only thing Libell sends is anonymous counts of how the app is used, which you can turn off."
      p class="menu__text" "Libell is free and open source (MIT license). "
        a class="menu__link" href="https://github.com/moggleif/libell" rel="noopener" target="_blank" "Source code on GitHub"
      p class="menu__text about__version" "<version>"
    div class="settings__tabpanel" hidden=""
      p class="menu__text" "Found a problem or have an idea? Fill this in and tap the button — it opens a ready-made report on GitHub where you post it (a free GitHub account is needed, created in a minute)."
      form class="settings__form"
        fieldset class="feedback__categories"
          legend class="menu__text" "What is it about?"
          label class="feedback__category" " Bug"
            input name="category" type="radio" value="bug"
          label class="feedback__category" " Suggestion"
            input name="category" type="radio" value="suggestion"
          label class="feedback__category" " Other"
            input name="category" type="radio" value="other"
        label class="settings__field settings__field--wide"
          span "Short title"
          input maxlength="200" type="text"
        label class="settings__field settings__field--wide"
          span "What happened, or what do you wish for?"
          textarea class="feedback__description" maxlength="2000" rows="4"
        p class="menu__text menu__text--warning feedback__warning" role="status" "The title and description are empty — you can send the report anyway."
        button class="menu__action" type="submit" "Open the report on GitHub"
    div class="stored-data settings__tabpanel" hidden=""
      p class="menu__text" "Your settings stay on your phone — no account and no tracking. The only thing Libell sends is anonymous counts of how the app is used, which you can turn off."
      p class="menu__text"
        a class="menu__link" href="/privacy/en/" rel="noopener" target="_blank" "Read the privacy policy"
      h3 class="stored-data__heading" "Stored on this phone"
      dl class="stored-data__list"
        p class="menu__text" "Nothing is stored."
      details class="settings__advanced stored-data__raw"
        summary class="settings__advanced-summary" "Show raw data"
        p class="settings__hint" "Exactly as stored. The box password is hidden."
        ul class="stored-data__raw-list"
      h3 class="stored-data__heading" "Anonymous counting"
      div
        p class="menu__text" "Libell can count use anonymously, so we know what to improve."
          a class="menu__link" href="https://libell.goatcounter.com" rel="noopener" target="_blank" "See the statistics"
        p class="settings__section" "What is counted"
        p class="menu__text" "That the app was opened, which features are used, which sensor measures (the phone or a model such as EasyLevel or Xparkle RVS01), the app version and the language chosen in Libell."
        p class="settings__section" "What is never saved"
        p class="menu__text" "Your IP address, country, device, screen, operating system or browser, your vehicle’s measurements, your settings, or anything else about you. Only your choice is kept on your phone." "If your browser asks websites not to track you, Libell counts nothing."
        label class="settings__field"
          span "Count my use anonymously"
          input class="settings__checkbox" type="checkbox"
      button class="menu__action menu__action--secondary" type="button" "Reset only the settings"
      button class="menu__action menu__action--danger" type="button" "Delete all Libell data"
      div class="stored-data__confirm" hidden="" role="group"
        p class="menu__text menu__text--status" "Delete everything Libell has stored on this phone? Vehicles, measurements and calibration are removed, and Libell starts again as the first time."
        button class="menu__action menu__action--danger" type="button" "Yes, delete everything"
        button class="menu__action menu__action--secondary" type="button" "Cancel""
`;

exports[`the Settings page (#735) > draws the same DOM 1`] = `
"div class="menu-page"
  div class="menu-page__header"
    button aria-label="Close menu" class="menu-page__back" type="button" "✕"
    h2 class="menu-page__title" tabindex="-1" "Settings"
  div class="menu-page__body"
    form class="settings__form"
      div class="settings__tabs" role="tablist"
        button aria-selected="true" class="settings__tab" data-tab="vehicle" role="tab" type="button" "Vehicle"
        button aria-selected="false" class="settings__tab" data-tab="ramps" role="tab" type="button" "Ramps"
        button aria-selected="false" class="settings__tab" data-tab="calibration" role="tab" type="button" "Calibrate and zero"
        button aria-selected="false" class="settings__tab" data-tab="targets" role="tab" type="button" "Level"
        button aria-selected="false" class="settings__tab" data-tab="general" role="tab" type="button" "General"
      div class="settings__tabpanel" data-tab="vehicle"
        div class="vehicles"
          p class="settings__section" "Vehicles"
          div class="choice__list"
            div class="choice__row"
              button aria-pressed="false" class="choice__row-select" type="button"
                span aria-hidden="true" class="choice__row-radio" "○"
                span class="choice__row-label" "My vehicle"
              button aria-label="Remove My vehicle" class="choice__row-delete" type="button" "✕"
            div class="choice__row"
              button aria-pressed="true" class="choice__row-select choice__row-select--active" type="button"
                span aria-hidden="true" class="choice__row-radio" "●"
                span class="choice__row-label" "Caravan"
              button aria-label="Remove Caravan" class="choice__row-delete" type="button" "✕"
          button class="menu__action menu__action--secondary" type="button" "New vehicle"
          div class="name-prompt" hidden=""
            input aria-label="Vehicle name" class="name-prompt__input" maxlength="40" placeholder="Name (e.g. \\"Caravan\\")" type="text"
            button class="menu__action menu__action--secondary" type="button" "Save"
            button class="menu__action menu__action--secondary" type="button" "Cancel"
          p aria-live="polite" class="menu__text menu__text--status"
          button class="menu__action menu__action--secondary" hidden="" type="button" "Yes, remove"
          p class="settings__hint" "Measurements, ramps, the vehicle zero, targets and the sensor box belong to the vehicle. The phone’s calibration is shared."
        label class="settings__field"
          span "Vehicle"
          select class="settings__select"
            option value="motorhome" "Motorhome"
            option value="caravan" "Caravan"
        label class="settings__field"
          span "Axle"
          select class="settings__select"
            option value="single" "Single"
            option value="boggie" "Tandem (boggie)"
        label class="settings__field"
          span "Axle to jockey wheel (mm)"
          input inputmode="decimal" min="10" name="wheelbaseMm" step="10" type="number"
        label class="settings__field" hidden=""
          span "Track width front (mm)"
          input inputmode="decimal" min="10" name="trackWidthFrontMm" step="10" type="number"
        label class="settings__field"
          span "Track width (mm)"
          input inputmode="decimal" min="10" name="trackWidthRearMm" step="10" type="number"
        p class="settings__hint" "Measure from the axle to the jockey wheel. A few cm off doesn't matter."
        button class="link-button settings__share-vehicle" type="button" "Share to another phone"
      div class="settings__tabpanel settings__tabpanel--klossar" data-tab="ramps" hidden=""
        div class="klossar__selected"
          div class="klossar__footer-head"
            span class="klossar__footer-label" "Selected"
            span class="klossar__footer-model" "Thule Levelers"
          span class="klossar__footer-heading" "Step heights (mm)"
          div class="klossar__grid" style="grid-template-columns: repeat(3, 1fr);"
            div class="klossar__grid-cell"
              span class="klossar__grid-label" "Step 1"
              span class="klossar__grid-value" "44"
            div class="klossar__grid-cell"
              span class="klossar__grid-label" "Step 2"
              span class="klossar__grid-value" "78"
            div class="klossar__grid-cell"
              span class="klossar__grid-label" "Step 3"
              span class="klossar__grid-value" "112"
        div class="klossar__custom-editor" hidden=""
          span "Ramp step heights (mm)"
          div class="steps__chips"
            span class="steps__chip"
              span "44 mm"
              button aria-label="Remove 44 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "78 mm"
              button aria-label="Remove 78 mm" class="steps__chip-remove" type="button" "−"
            span class="steps__chip"
              span "112 mm"
              button aria-label="Remove 112 mm" class="steps__chip-remove" type="button" "−"
          div class="steps__add"
            input aria-label="New step height (mm)" inputmode="decimal" placeholder="40" type="number"
            button class="menu__action menu__action--secondary steps__add-btn" type="button" "+ Add step"
        label class="settings__field" hidden=""
          span "Number of ramps"
          select class="settings__select"
            option value="1" "1"
            option value="2" "2"
            option value="3" "3"
            option value="4" "4"
        p class="settings__hint" hidden="" "The app puts them where they help most."
        details class="settings__advanced klossar__picker-details"
          summary class="settings__advanced-summary" "Change ramp"
          div class="klossar__filter"
            button aria-pressed="true" class="klossar__chip" type="button" "All"
            button class="klossar__chip" type="button" "Thule"
            button class="klossar__chip" type="button" "Fiamma"
            button class="klossar__chip" type="button" "Milenco"
            button class="klossar__chip" type="button" "Froli"
            button class="klossar__chip" type="button" "Biltema"
            button class="klossar__chip" type="button" "Brunner"
            button class="klossar__chip" type="button" "Hamron"
            button class="klossar__chip" type="button" "Briv"
            button class="klossar__chip" type="button" "TrutzHolm"
            button class="klossar__chip" type="button" "Lippert"
            button class="klossar__chip" type="button" "Andersen"
          div class="klossar__list"
            button aria-pressed="false" class="klossar__row klossar__row--custom" type="button"
              span class="klossar__row-name" "Custom set"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row klossar__row--custom" type="button"
              span class="klossar__row-name" "Stepless wedge"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="true" class="klossar__row klossar__row--selected" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Thule Levelers"
                span class="klossar__row-mm" "44/78/112 mm"
              span aria-hidden="true" class="klossar__radio klossar__radio--selected"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Fiamma Level Up"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Fiamma Level Up Premium"
                span class="klossar__row-mm" "70/130/170 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Milenco Triple Level"
                span class="klossar__row-mm" "40/80/120 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Milenco Trident Level"
                span class="klossar__row-mm" "40/110/170 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Milenco Quattro Level"
                span class="klossar__row-mm" "40/80/120/160 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Milenco Quattro 3 Level"
                span class="klossar__row-mm" "40/90/130/178 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Froli trappkil XL"
                span class="klossar__row-mm" "65/115 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Froli kompaktkil"
                span class="klossar__row-mm" "50/100/150 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Biltema nivåkloss"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Biltema byggbar nivåkloss"
                span class="klossar__row-mm" "25/50/75/100/125 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Brunner Equalizer XL"
                span class="klossar__row-mm" "45/80/110 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Fiamma Jumbo"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Hamron nivåklossar"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Briv nivåklossar"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "TrutzHolm Auffahrkeil 5 t"
                span class="klossar__row-mm" "40/70/100 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Lippert LEVEL9"
                span class="klossar__row-mm" "20/40/60/80/100/120/140/160/180 mm"
              span aria-hidden="true" class="klossar__radio"
            button aria-pressed="false" class="klossar__row" type="button"
              span class="klossar__row-info"
                span class="klossar__row-name" "Andersen Camper Leveler"
                span class="klossar__row-mm" "Max height 101 mm"
              span aria-hidden="true" class="klossar__radio"
      div class="settings__tabpanel" data-tab="calibration" hidden=""
        div class="calibration-cards"
          div class="box-setup"
            div class="box-step is-done"
              button class="box-step__header" type="button"
                span class="box-step__mark" "✓"
                span class="box-step__title" "Phone calibrated"
              div class="box-step__body" hidden=""
                p class="menu__text" "Lay the phone on something flat."
                button class="menu__action" type="button" "Calibrate now"
                p class="menu__text menu__text--status" hidden=""
                button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
                button class="link-button" type="button" "No flat surface? Flip the phone"
                div hidden=""
                  p class="calibration-card__body" "No level surface around? Use flip calibration: put the phone down anywhere reasonably flat, capture, rotate the phone half a turn (180°) on the same spot, capture again — the surface tilt cancels itself out."
                  button class="menu__action" type="button" "Calibrate by flipping"
                  p class="menu__text menu__text--status"
                  button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
                details class="menu__detail"
                  summary class="sensor-status__debug-summary" "More"
                  button class="menu__action menu__action--secondary" type="button" "Check"
                  button class="menu__action menu__action--secondary" type="button" "Clear calibration"
            div class="box-step is-open"
              button class="box-step__header" type="button"
                span class="box-step__mark" "2"
                span class="box-step__title" "Zero the vehicle"
              div class="box-step__body"
                p class="menu__text" "Level the vehicle with a spirit level and put the phone in its usual spot."
                button class="menu__action" type="button" "Zero now"
                p class="menu__text menu__text--status" hidden=""
                button class="menu__action menu__action--secondary" hidden="" type="button" "Undo"
                details class="menu__detail"
                  summary class="sensor-status__debug-summary" "More"
                  button class="menu__action menu__action--secondary" type="button" "Check"
                  button class="menu__action menu__action--secondary" hidden="" type="button" "Forget the zero"
      div class="settings__tabpanel" data-tab="targets" hidden=""
        label class="settings__field"
          span "Tolerance (mm)"
          input inputmode="decimal" min="1" name="toleranceMm" step="1" type="number"
        p class="settings__hint" "How close to level counts as level."
        label class="settings__field" hidden=""
          span "Drain side"
          select class="settings__select"
            option value="none" "None / does not matter"
            option value="left" "Left, middle"
            option value="right" "Right, middle"
            option value="front" "Front, middle"
            option value="rear" "Rear, middle"
            option value="frontLeft" "Front left"
            option value="frontRight" "Front right"
            option value="rearLeft" "Rear left"
            option value="rearRight" "Rear right"
        p class="settings__hint" hidden="" "Within the tolerance, this side is left lowest so water drains."
        p class="settings__section" "Targets"
        div
          div class="choice__list"
            div class="choice__row"
              button aria-pressed="false" class="choice__row-select" type="button"
                span aria-hidden="true" class="choice__row-radio" "○"
                span class="choice__row-label" "Normal (level)"
            div class="choice__row"
              button aria-pressed="true" class="choice__row-select choice__row-select--active" type="button"
                span aria-hidden="true" class="choice__row-radio" "●"
                span class="choice__row-label" "Shower drain"
              button aria-label="Delete Shower drain" class="choice__row-delete" type="button" "✕"
          button class="menu__action menu__action--secondary" type="button" "Save current tilt as new target"
          div class="name-prompt" hidden=""
            input aria-label="Name of the new target" class="name-prompt__input" maxlength="40" placeholder="Name (e.g. \\"Shower drain\\")" type="text"
            button class="menu__action menu__action--secondary" type="button" "Save"
            button class="menu__action menu__action--secondary" type="button" "Cancel"
          p class="menu__text menu__text--status"
          div class="hitch"
            p class="settings__section" "Hitch height"
            p class="menu__text" "Save it while the caravan is still on the tow ball. Before you hitch up again, the jockey wheel shows how far to crank so the coupling meets the ball."
            p aria-live="polite" class="menu__text menu__text--status" "A hitch height is saved."
            button class="menu__action" type="button" "Back to hitch height"
            button class="menu__action" hidden="" type="button" "Done"
            button class="menu__action menu__action--secondary" type="button" "Save hitch height"
      div class="settings__tabpanel" data-tab="general" hidden=""
        label class="settings__field"
          span "Language"
          select class="settings__select"
            option value="auto" "Automatic (device language)"
            option value="ca" "Català"
            option value="cs" "Čeština"
            option value="da" "Dansk"
            option value="de" "Deutsch"
            option value="et" "Eesti"
            option value="en" "English"
            option value="es" "Español"
            option value="fr" "Français"
            option value="hr" "Hrvatski"
            option value="is" "Íslenska"
            option value="it" "Italiano"
            option value="lv" "Latviešu"
            option value="lt" "Lietuvių"
            option value="hu" "Magyar"
            option value="nl" "Nederlands"
            option value="nb" "Norsk bokmål"
            option value="pl" "Polski"
            option value="pt" "Português"
            option value="ro" "Română"
            option value="sk" "Slovenčina"
            option value="sl" "Slovenščina"
            option value="fi" "Suomi"
            option value="sv" "Svenska"
            option value="tr" "Türkçe"
        label class="settings__field"
          span "Theme"
          select class="settings__select"
            option value="system" "Follow the phone"
            option value="light" "Light"
            option value="dark" "Dark"
        label class="settings__field"
          span "Appearance"
          select class="settings__select"
            option value="classic" "Classic"
            option value="modern" "Modern"
            option value="glossy" "Glossy"
        label class="settings__field"
          span "Show lengths in"
          select class="settings__select"
            option value="mm" "mm"
            option value="cm" "cm"
            option value="in" "inches (in)"
        p class="settings__section" "Sound"
        label class="settings__field"
          span "Chime when level"
          input class="settings__checkbox" type="checkbox"
        label class="settings__field"
          span "Continuous audio guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "The beep gets faster and higher the closer you get to level."
        label class="settings__field"
          span "Spoken guidance"
          input class="settings__checkbox" type="checkbox"
        p class="settings__hint" "Spoken guidance does not work on this phone: it has no English voice that works offline. The tones work as usual."
        details class="settings__advanced settings__more"
          summary class="settings__advanced-summary" "More"
          p class="settings__section" "Fine-tuning"
          label class="settings__field"
            span "Stability (mm)"
            input inputmode="decimal" min="0" name="stabilityMm" step="0.5" type="number"
          p class="settings__hint" "Smooths out small sensor jitter so the numbers do not flicker."
          label class="settings__field"
            span "Response delay (ms)"
            input inputmode="decimal" min="50" name="dwellRestMs" step="50" type="number"
          label class="settings__field"
            span "Response delay while adjusting (ms)"
            input inputmode="decimal" min="20" name="dwellMotionMs" step="10" type="number"
          p class="settings__hint" "How long a reading must hold before the number changes."
          button class="menu__action menu__action--secondary settings__reset-all" type="button" "Reset all settings""
`;

