                span class="klossar__row-info"
                  span class="klossar__row-name" "Andersen Camper Leveler"
                  span class="klossar__row-mm" "Max height 101 mm"
                span aria-hidden="true" class="klossar__radio""
`;

exports[`the ☰ menu (#735) > draws the same DOM on its targets page 1`] = `
"div
  div class="menu"
    div aria-label="Menu" class="menu__drawer" role="dialog"
      div class="menu__header"
        span class="menu__title" "Menu"
        button aria-label="Close menu" class="menu__close" type="button" "✕"
      button class="menu__item" type="button" "Vehicle"
      button class="menu__item" type="button" "Ramps"
      button class="menu__item" type="button" "Calibrate and zero"
      button class="menu__item" type="button" "Level"
      button class="menu__item" type="button" "General"
  div class="menu-page"
    div class="menu-page__header"
      button class="menu-page__back" type="button" "‹"
      h2 class="menu-page__title" tabindex="-1" "Level"
    div class="menu-page__body"
      form class="settings__form"
        div
          label class="settings__field"
            span "Tolerance (mm)"
            input inputmode="decimal" min="1" name="toleranceMm" step="1" type="number"
          p class="settings__hint" "How close to level counts as level."
          label class="settings__field" hidden=""
            span "Drain side"
            select class="settings__select"
              option value="none" "None / does not matter"
              option value="left" "Left, middle"
              option value="right" "Right, middle"
              option value="front" "Front, middle"
              option value="rear" "Rear, middle"
              option value="frontLeft" "Front left"
              option value="frontRight" "Front right"
              option value="rearLeft" "Rear left"
              option value="rearRight" "Rear right"
          p class="settings__hint" hidden="" "Within the tolerance, this side is left lowest so water drains."
          p class="settings__section" "Targets"
          div
            div class="choice__list"
              div class="choice__row"
                button aria-pressed="false" class="choice__row-select" type="button"
                  span aria-hidden="true" class="choice__row-radio" "○"
                  span class="choice__row-label" "Normal (level)"
              div class="choice__row"
                button aria-pressed="true" class="choice__row-select choice__row-select--active" type="button"
                  span aria-hidden="true" class="choice__row-radio" "●"
                  span class="choice__row-label" "Shower drain"
                button aria-label="Delete Shower drain" class="choice__row-delete" type="button" "✕"
            button class="menu__action menu__action--secondary" type="button" "Save current tilt as new target"
            div class="name-prompt" hidden=""
              input aria-label="Name of the new target" class="name-prompt__input" maxlength="40" placeholder="Name (e.g. \\"Shower drain\\")" type="text"
              button class="menu__action menu__action--secondary" type="button" "Save"
              button class="menu__action menu__action--secondary" type="button" "Cancel"
            p class="menu__text menu__text--status"
            div class="hitch"
              p class="settings__section" "Hitch height"
              p class="menu__text" "Save it while the caravan is still on the tow ball. Before you hitch up again, the jockey wheel shows how far to crank so the coupling meets the ball."
              p aria-live="polite" class="menu__text menu__text--status" "A hitch height is saved."
              button class="menu__action" type="button" "Back to hitch height"
              button class="menu__action" hidden="" type="button" "Done"
              button class="menu__action menu__action--secondary" type="button" "Save hitch height""
`;

exports[`the ☰ menu (#735) > draws the same DOM on its vehicle page 1`] = `
"div
  div class="menu"
    div aria-label="Menu" class="menu__drawer" role="dialog"
      div class="menu__header"
        span class="menu__title" "Menu"
        button aria-label="Close menu" class="menu__close" type="button" "✕"
      button class="menu__item" type="button" "Vehicle"
      button class="menu__item" type="button" "Ramps"
      button class="menu__item" type="button" "Calibrate and zero"
      button class="menu__item" type="button" "Level"
      button class="menu__item" type="button" "General"
  div class="menu-page"
    div class="menu-page__header"
      button class="menu-page__back" type="button" "‹"
      h2 class="menu-page__title" tabindex="-1" "Vehicle"
    div class="menu-page__body"
      form class="settings__form"
        div
          div class="vehicles"
            p class="settings__section" "Vehicles"
            div class="choice__list"
              div class="choice__row"
                button aria-pressed="false" class="choice__row-select" type="button"
                  span aria-hidden="true" class="choice__row-radio" "○"
                  span class="choice__row-label" "My vehicle"
                button aria-label="Remove My vehicle" class="choice__row-delete" type="button" "✕"
              div class="choice__row"
                button aria-pressed="true" class="choice__row-select choice__row-select--active" type="button"
                  span aria-hidden="true" class="choice__row-radio" "●"
                  span class="choice__row-label" "Caravan"
                button aria-label="Remove Caravan" class="choice__row-delete" type="button" "✕"
            button class="menu__action menu__action--secondary" type="button" "New vehicle"
            div class="name-prompt" hidden=""
              input aria-label="Vehicle name" class="name-prompt__input" maxlength="40" placeholder="Name (e.g. \\"Caravan\\")" type="text"
              button class="menu__action menu__action--secondary" type="button" "Save"
              button class="menu__action menu__action--secondary" type="button" "Cancel"
            p aria-live="polite" class="menu__text menu__text--status"
            button class="menu__action menu__action--secondary" hidden="" type="button" "Yes, remove"
            p class="settings__hint" "Measurements, ramps, the vehicle zero, targets and the sensor box belong to the vehicle. The phone’s calibration is shared."
          label class="settings__field"
            span "Vehicle"
            select class="settings__select"
              option value="motorhome" "Motorhome"
              option value="caravan" "Caravan"
          label class="settings__field"
            span "Axle"
            select class="settings__select"
              option value="single" "Single"
              option value="boggie" "Tandem (boggie)"
          label class="settings__field"
            span "Axle to jockey wheel (mm)"
            input inputmode="decimal" min="10" name="wheelbaseMm" step="10" type="number"
          label class="settings__field" hidden=""
            span "Track width front (mm)"
            input inputmode="decimal" min="10" name="trackWidthFrontMm" step="10" type="number"
          label class="settings__field"
            span "Track width (mm)"
            input inputmode="decimal" min="10" name="trackWidthRearMm" step="10" type="number"
          p class="settings__hint" "Measure from the axle to the jockey wheel. A few cm off doesn't matter."
          button class="link-button settings__share-vehicle" type="button" "Share to another phone""
`;
